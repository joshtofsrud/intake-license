+.mb-tl .bk.pend { background: color-mix(in srgb, var(--mb-today) 12%, var(--ia-bg)); border-color: color-mix(in srgb, var(--mb-today) 45%, transparent); }
+.mb-tl .bk > div:first-child { min-width: 0; }
+.mb-tl .bk .who { font-weight: 600; display: block; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
+.mb-tl .bk .tm { font-family: var(--ia-font-mono); font-size: 11px; color: var(--mb-dim); display: block; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
+.mb-tl .bk .side { margin-left: auto; flex: none; font-size: 12px; font-weight: 600; }
+.mb-tl .bk.ok .side { color: var(--mb-ink); font-weight: 500; }
+.mb-tl .bk.pend .side { color: var(--mb-today); }
+.mb-tl .open { position: absolute; left: 0; right: 0; z-index: 1; background: var(--ia-bg); border: 1px dashed var(--ia-border-strong); border-radius: 7px; display: flex; align-items: center; justify-content: space-between; padding: 0 10px; font-size: 12px; color: var(--mb-dim); opacity: .7; text-decoration: none; transition: opacity var(--ia-t); }
+.mb-tl .open:hover { opacity: 1; }
+.mb-tl .open b { font-weight: 500; color: var(--mb-ink); }
+.mb-tl .now { position: absolute; left: -8px; right: 0; height: 0; border-top: 2px solid var(--mb-late); z-index: 3; }
+.mb-tl .now::before { content: ''; position: absolute; left: -4px; top: -5px; width: 8px; height: 8px; border-radius: 50%; background: var(--mb-late); }
+.mb-tl .now span { position: absolute; right: 0; top: -18px; font-size: 10.5px; font-weight: 600; color: var(--mb-late); }
+.mb-tl .closed { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; color: var(--mb-dim); font-size: 13px; background: repeating-linear-gradient(135deg, transparent 0 8px, var(--ia-hover) 8px 16px); border-radius: 7px; }
+.mb-legend { display: flex; gap: 16px; flex-wrap: wrap; font-size: 11.5px; color: var(--mb-dim); margin-top: 10px; }
+.mb-legend i { display: inline-block; width: 9px; height: 9px; border-radius: 2px; margin-right: 6px; vertical-align: -1px; border: 1px solid; }
+.mb-legend .a { background: color-mix(in srgb, var(--ia-accent) 12%, var(--ia-bg)); border-color: color-mix(in srgb, var(--ia-accent) 40%, transparent); }
+.mb-legend .b { background: color-mix(in srgb, var(--mb-today) 12%, var(--ia-bg)); border-color: color-mix(in srgb, var(--mb-today) 45%, transparent); }
+.mb-legend .c { border-style: dashed; border-color: var(--ia-border-strong); }
+
+/* last 30 days */
+.mb-stats { margin-top: 40px; }
+.mb-st { display: grid; grid-template-columns: 1fr 110px auto; gap: 14px; align-items: center; padding: 13px 0; border-bottom: 1px solid var(--ia-border); }
