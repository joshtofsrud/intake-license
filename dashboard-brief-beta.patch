+.mb-day { background: none; border: 0; color: var(--mb-dim); padding: 6px 0 10px; text-align: center; border-bottom: 2px solid transparent; margin-bottom: -1px; font-family: inherit; cursor: pointer; }
+.mb-day .w { font-size: 10.5px; font-weight: 600; letter-spacing: .1em; text-transform: uppercase; }
+.mb-day .d { font-size: 19px; font-weight: 600; color: var(--ia-text); line-height: 1.3; }
+.mb-day .dots { height: 9px; display: flex; justify-content: center; gap: 3px; margin-top: 2px; font-size: 10px; line-height: 9px; }
