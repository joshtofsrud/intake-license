+body.ia-theme-c .rf-tog button.ok{background:color-mix(in srgb,var(--sd-t3) 22%,var(--ia-surface));color:var(--sd-t3)}
+.rf-tog button.flag,.rf-tog button.mt{background:color-mix(in srgb,var(--sd-bad) 16%,var(--ia-surface));color:var(--sd-bad)}
+.rf-cu-more{display:grid;grid-template-columns:minmax(0,1fr) 220px;gap:12px;padding:10px 0 0 52px}
