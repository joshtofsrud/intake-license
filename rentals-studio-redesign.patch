+/* tablet and phone */
+@media (max-width:1023px){
+  .rf .dash-row>.dash-col{display:block}
+  .rf-rail{order:0}
+}
+@media (max-width:900px){
+  .rf-cat-h{grid-template-columns:22px minmax(0,1fr) 84px 30px}
+  .rf-cat-h .rd-bar{grid-column:2/-1;order:5}
