+/* ---------------- booking detail: the live page's own pieces ---------------- */
+.ia-confirm-backdrop[hidden]{display:none}
+.rf-track-t span{display:flex;flex-direction:column;line-height:1.25}
+.rf-track-t small{font-size:10.5px;font-weight:400;color:var(--ia-text-dim)}
+.rf-track-t .late small{color:var(--sd-bad)}
+.rf-track-t .late{color:var(--sd-bad)}
+.rf .rf-tl .sd-tl-r{grid-template-columns:104px minmax(0,1fr)}
+.rf-tot dt form{display:inline}
+.rf-pay b .rf-st{margin-left:6px;padding:1px 8px;font-size:10.5px}
+.rf-pay>div small{margin-top:2px}
+.rf-capture{display:inline-block;vertical-align:top}
+.rf-capture summary{list-style:none;cursor:pointer}
+.rf-capture summary::-webkit-details-marker{display:none}
+.rf-capture form{display:flex;flex-direction:column;gap:8px;margin-top:10px}
+.rf-capture .rf-money .ia-input,.rf-capture>form>.ia-input{height:32px}
+.rf-doc-row{display:flex;justify-content:space-between;align-items:center;gap:10px;padding:7px 0;font-size:12.5px;border-bottom:1px dashed var(--ia-border)}
+.rf-doc-row span{display:flex;gap:6px}
+.rf-doc-row a{width:22px;height:22px;border-radius:6px;display:grid;place-items:center;background:var(--ia-surface-2);color:var(--ia-text);text-decoration:none;font-size:11px;font-weight:600}
+.rf-doc-row a:hover{background:var(--ia-hover)}
+.rf-note-text{font-size:12.5px;margin:0;white-space:pre-wrap;color:var(--ia-text)}
+.rf-quiet form{display:block}
+.rf-quiet button{width:100%}
+.rf-quiet .bad{color:var(--sd-bad)}
+.rf-disc-f label{display:flex;flex-direction:column;gap:5px;margin-bottom:12px}
+.rf-disc-row{display:grid;grid-template-columns:1fr 1fr;gap:10px}
+.rf-or{display:flex;align-items:center;gap:10px;margin:14px 0;font-size:11px;color:var(--ia-text-dim);text-transform:uppercase;letter-spacing:.06em}
+.rf-or i{flex:1;height:1px;background:var(--ia-border)}
+summary.ia-btn{display:inline-flex;align-items:center}
+@media (max-width:900px){
+  .rf-line{grid-template-columns:40px minmax(0,1fr) auto}
+  .rf-line>:nth-child(3){display:none}
+  .rf-track-t small{display:none}
+  .rf-track-t div{gap:6px;font-size:11.5px}
+  .rf .rf-tl .sd-tl-r{grid-template-columns:86px minmax(0,1fr)}
+}
+
+/* ---------------- new rental extras ---------------- */
+.rf-picked-c[hidden],.rf-tot[hidden],.rf-newc[hidden],.rf-drop[hidden],#nr-cust-search-wrap[hidden]{display:none}
+.rf-newc-g{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}
+.rf-pk-mode{display:block;margin-top:6px;height:30px;font-size:12px;padding:0 8px;max-width:100%}
+.rf-pk .rf-ib{align-self:start}
+.rf-free-cat:first-child{margin-top:4px}
+.rf-picked{margin-bottom:4px}
+@media (max-width:900px){
+  .rf-free{grid-template-columns:40px minmax(0,1fr) auto 74px}
+  .rf-free>.rf-mono,.rf-free>span:nth-of-type(2){display:none}
+  .rf-newc-g{grid-template-columns:minmax(0,1fr)}
+}
+
+/* ---------------- check-out / return flow extras ---------------- */
+.co-pane[hidden]{display:none}
+.rf-err{margin-top:8px}
+.rf-signed>div{flex:1;min-width:0}.rf-signed b{display:block;font-size:13.5px}.rf-signed small{font-size:12px;display:block}
+.rf-signed a{color:var(--ia-text);text-decoration:underline;text-underline-offset:2px}
+.rf-sigimg{max-height:48px;max-width:140px;background:#f7f7f5;border-radius:8px;padding:4px 8px;flex:none}
+.rf-wait-acts{display:flex;gap:6px;flex-wrap:wrap;justify-content:flex-end}
+.rf-pickreg{margin-top:12px;padding:14px 16px;border-radius:14px;background:color-mix(in srgb,var(--sd-t2) 22%,var(--ia-surface))}
+body.ia-theme-c .rf-pickreg{background:color-mix(in srgb,var(--sd-t2) 8%,var(--ia-surface))}
+.rf-pickreg b{display:block;font-size:13.5px}.rf-pickreg small{display:block;font-size:12px;color:var(--ia-text-muted);margin-top:2px}
+.rf-agreed{display:flex;gap:9px;align-items:center;font-size:12.5px;margin-top:12px;cursor:pointer}
+.rf-cu-done{margin:0;padding:6px 0 0 52px;font-size:12.5px;color:var(--ia-text-muted)}
+.rf-hold .rf-collect .ia-input{height:34px}
+@media (max-width:900px){
+  .rf-cu-done{padding-left:0}
+  .rf-wait{flex-wrap:wrap}.rf-wait-acts{justify-content:flex-start}
+  .rf-flow button{padding:9px 10px}
+}
+
+/* ---------------- return extras ---------------- */
+.rt-pane[hidden]{display:none}
+.rf-outnote{font-size:12px;color:var(--ia-text-muted);padding:8px 0 8px 52px;line-height:1.55}
+.rf-outnote b{color:var(--ia-text);font-weight:600}
+.rf-outnote a{color:var(--ia-text);text-decoration:underline;text-underline-offset:2px}
+.rf-charge--2{grid-template-columns:minmax(0,1fr) 130px 24px}
+.rf-sugg .rf-money .ia-input{height:32px}
+.rf-radio label.rf-opt{display:block;cursor:pointer}
+.rf-route-row{grid-template-columns:40px minmax(0,1fr) auto;row-gap:8px}
+.rf-route-row .rf-route-note{grid-column:2 / -1}
+@media (max-width:900px){
+  .rf-outnote{padding-left:0}
+  .rf-charge--2{grid-template-columns:minmax(0,1fr) 100px 24px}
+  .rf-sugg{flex-wrap:wrap}
+}
