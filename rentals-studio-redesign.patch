+/* toast */
+.rf-toast{position:fixed;left:50%;bottom:28px;z-index:130;transform:translateX(-50%);padding:10px 18px;border-radius:99px;background:var(--ia-text);color:var(--ia-bg);font-size:13px;font-weight:600;box-shadow:0 10px 30px rgba(0,0,0,.25)}
