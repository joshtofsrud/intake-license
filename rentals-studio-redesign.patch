+.rf-pills a.rf-pill{text-decoration:none}
+.rf-seg-a{text-decoration:none}
+.sd-seg a{border:0;background:none;font:inherit;font-size:12px;font-weight:600;padding:5px 11px;border-radius:6px;color:var(--ia-text-muted);cursor:pointer;display:inline-flex;align-items:center;text-decoration:none}
