+
+/* size-axis "?" popover (the shared _size_axis_help partial) */
+.fl-help{position:relative;display:inline-flex;margin-left:6px;vertical-align:middle}
+.fl-help-dot{width:15px;height:15px;border-radius:50%;border:1px solid var(--ia-border-strong);color:var(--ia-text-dim);background:none;font-size:10px;font-weight:700;line-height:1;display:flex;align-items:center;justify-content:center;cursor:pointer;padding:0}
