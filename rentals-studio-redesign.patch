diff --git a/public/css/tenant/rentals-studio.css b/public/css/tenant/rentals-studio.css
new file mode 100644
index 00000000..513a7ed7
--- /dev/null
+++ b/public/css/tenant/rentals-studio.css
@@ -0,0 +1,491 @@
+/* MARKER-RENTALS-STUDIO — every staff rental page in the Studio design.
+   New file (public/css/tenant/rentals-studio.css), loaded after
+   dashboard-studio.css; nothing in that file or the theme files is changed.
+   Uses only the theme tokens (--ia-*) and the Studio tones (--sd-*). */
+
+.rf-crumb{font-size:12px;color:var(--ia-text-muted);margin-bottom:4px}
+.rf-crumb a{color:inherit;text-decoration:none}.rf-crumb a:hover{color:var(--ia-text)}
+.sd-head.frost .rf-crumb{display:none}
+.rf-hpill{display:inline-block;vertical-align:6px;margin-left:10px}
+.sd-head.frost .rf-hpill{vertical-align:2px}
+
+/* control line: segmented status + compact pills, beside what they affect */
+.rf-ctl{display:flex;align-items:center;justify-content:space-between;gap:10px 14px;flex-wrap:wrap;margin:0 0 18px}
+.sd-seg button em{font-style:normal;font-variant-numeric:tabular-nums;opacity:.6;margin-left:3px}
+.rf-pills{display:flex;gap:6px;flex-wrap:wrap;align-items:center}
+.rf-pill{height:30px;padding:0 12px;border-radius:99px;border:1px solid var(--ia-border);background:none;color:var(--ia-text-muted);font:inherit;font-size:12px;font-weight:600;cursor:pointer;display:inline-flex;align-items:center;gap:6px}
+.rf-pill:hover{color:var(--ia-text);border-color:var(--ia-border-strong)}
+.rf-pill.on{background:var(--ia-text);color:var(--ia-bg);border-color:var(--ia-text)}
+.rf-pill i{font-style:normal;font-size:10px;opacity:.7}
+.rf-pill.add{border-style:dashed}
+
+/* status pill: one vocabulary, theme-aware (replaces _status-pill's dark-only colours) */
+.rf-st{--c:var(--sd-t1);display:inline-flex;align-items:center;gap:6px;font-size:11px;font-weight:600;padding:3px 10px;border-radius:99px;white-space:nowrap;background:color-mix(in srgb,var(--c) 42%,transparent);color:var(--sd-ink)}
+.rf-st::before{content:'';width:5px;height:5px;border-radius:50%;background:currentColor;opacity:.7}
+body.ia-theme-c .rf-st{background:color-mix(in srgb,var(--c) 16%,transparent);color:var(--c)}
+.rf-st.late{background:color-mix(in srgb,var(--sd-bad) 16%,transparent)!important;color:var(--sd-bad)!important}
+.rf-st.due,.rf-st.res{--c:var(--sd-t4)} .rf-st.out,.rf-st.av,.rf-st.done{--c:var(--sd-t3)} .rf-st.going,.rf-st.bal{--c:var(--sd-t1)}
+.rf-st.mt{--c:var(--sd-bad)} .rf-st.off{--c:var(--ia-text-dim)}
+.rf-st.done{opacity:.75}
+
+/* ---------------- fleet ---------------- */
+.rf-cat{margin-bottom:6px}
+.rf-cat-h{display:grid;grid-template-columns:22px minmax(0,1.1fr) minmax(0,2fr) 130px 92px 30px;gap:16px;align-items:center;padding:14px 6px 12px;border-bottom:1px solid var(--ia-border-strong);cursor:pointer;border-radius:10px 10px 0 0}
+.rf-cat-h:hover{background:var(--ia-hover)}
+.rf-cat-h h2{font-size:15px;font-weight:600;margin:0;line-height:1.3}
+.rf-cat-h small{display:block;font-size:11.5px;color:var(--ia-text-muted)}
+.rf-disc{width:22px;height:22px;display:grid;place-items:center;color:var(--ia-text-dim);transition:transform .2s}
+.rf-cat.open>.rf-cat-h .rf-disc,.rf-model.open>.rf-model-h .rf-disc{transform:rotate(90deg)}
+.rf-cat-b{display:none;padding:2px 0 18px}
+.rf-cat.open>.rf-cat-b{display:block}
+.rf-ib{width:28px;height:28px;border-radius:8px;border:0;background:none;color:var(--ia-text-dim);font-size:13px;display:grid;place-items:center;cursor:pointer}
+.rf-ib:hover{background:var(--ia-surface-2);color:var(--ia-text)}
+
+.rf-model{border-bottom:1px solid var(--ia-border)}
+.rf-model-h{display:grid;grid-template-columns:22px 44px minmax(0,1.3fr) minmax(0,1.5fr) 70px 84px auto;gap:14px;align-items:center;padding:10px 6px;border-radius:10px;cursor:pointer;transition:background .15s}
+.rf-model-h:hover{background:var(--ia-hover)}
+.rf-model.open>.rf-model-h{background:color-mix(in srgb,var(--sd-t3) 14%,transparent)}
+body.ia-theme-c .rf-model.open>.rf-model-h{background:color-mix(in srgb,var(--sd-t3) 6%,transparent)}
+.rf-thumb{width:44px;height:44px;border-radius:12px;background:var(--ia-surface-2) center/cover;display:grid;place-items:center;color:var(--ia-text-dim);font-size:11px;font-weight:700;overflow:hidden}
+.rf-mname b{display:block;font-size:13.5px;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
+.rf-mname small{font-size:11.5px;color:var(--ia-text-muted)}
+.rf-rates{display:flex;gap:6px;flex-wrap:wrap}
+.rf-rate{font-size:11.5px;color:var(--ia-text-muted);padding:2px 8px;border-radius:6px;background:var(--ia-surface-2);white-space:nowrap}
+.rf-rate b{color:var(--ia-text);font-weight:600}
+.rf-mcount{font:500 11.5px var(--ia-font-mono);color:var(--ia-text-muted)}
+.rf-model-h .ia-btn{justify-self:end}
+
+.rf-units{display:none;padding:4px 0 14px 36px}
+.rf-model.open>.rf-units{display:block}
+.rf-uh,.rf-u{display:grid;grid-template-columns:34px 104px 64px var(--idf,0px) minmax(0,1fr) 128px 74px 70px 20px;gap:12px;align-items:center}
+.rf-uh{padding:8px 8px 6px;font-size:10.5px;text-transform:uppercase;letter-spacing:.06em;color:var(--ia-text-dim);font-weight:600}
+.rf-u{padding:7px 8px;border-radius:9px;font-size:12.5px;color:inherit;text-decoration:none;cursor:pointer}
+.rf-u:hover{background:var(--ia-hover)}
+.rf-u .rf-thumb{width:30px;height:30px;border-radius:8px}
+.rf-mono{font-family:var(--ia-font-mono);font-size:12px}
+.rf-dim{color:var(--ia-text-dim)}
+.rf-flag{color:var(--sd-bad);font-weight:600}
+.rf-u select{height:26px;border-radius:99px;border:1px solid var(--ia-border);background:var(--ia-input-bg);color:var(--ia-text);font:inherit;font-size:11.5px;font-weight:600;padding:0 22px 0 10px;appearance:none;background-image:linear-gradient(45deg,transparent 50%,currentColor 50%),linear-gradient(135deg,currentColor 50%,transparent 50%);background-position:calc(100% - 12px) 11px,calc(100% - 8px) 11px;background-size:4px 4px;background-repeat:no-repeat}
+.rf-idv{border:0;background:none;color:var(--ia-text);font:inherit;font-size:12.5px;width:100%;padding:3px 6px;border-radius:6px}
+.rf-idv:hover,.rf-idv:focus{background:var(--ia-input-bg);outline:none}
+.rf-use{display:flex;align-items:center;gap:6px;font:500 11px var(--ia-font-mono);color:var(--ia-text-muted)}
+.rf-use i{display:block;width:28px;height:4px;border-radius:99px;background:var(--ia-surface-2);position:relative;overflow:hidden}
+.rf-use i::after{content:'';position:absolute;inset:0 auto 0 0;width:var(--w);background:var(--sd-t3);border-radius:inherit}
+.rf-go{color:var(--ia-text-dim);font-size:13px}
+.rf-u:hover .rf-go{color:var(--ia-text)}
+
+/* add units: one labelled line under the roster */
+.rf-addu[hidden]{display:none}
+.rf-addu{display:flex;align-items:flex-end;gap:10px;flex-wrap:wrap;padding:12px 8px 4px;margin-top:6px;border-top:1px dashed var(--ia-border)}
+.rf-addu label{display:flex;flex-direction:column;gap:4px}
+.rf-addu .ia-input{height:32px;padding:5px 10px}
+.rf-lbl{font-size:10.5px;text-transform:uppercase;letter-spacing:.06em;color:var(--ia-text-dim);font-weight:600}
+.rf-addu-open{margin:8px 0 0 8px}
+
+/* ---------------- side drawer ---------------- */
+.rf-scrim{position:fixed;inset:0;z-index:90;background:rgba(0,0,0,.35);opacity:0;transition:opacity .2s}
+.rf-scrim.on{opacity:1}
+.rf-drawer{position:fixed;top:0;right:0;bottom:0;z-index:91;width:min(520px,100vw);display:flex;flex-direction:column;background:var(--ia-surface);border-left:1px solid var(--ia-border-strong);box-shadow:-20px 0 50px rgba(0,0,0,.25);transform:translateX(104%);transition:transform .32s cubic-bezier(.2,.7,.1,1)}
+.rf-drawer.on{transform:none}
+.rf-dh{display:flex;justify-content:space-between;align-items:flex-start;gap:12px;padding:22px 24px 14px;border-bottom:1px solid var(--ia-border)}
+.rf-dh h3{margin:0;font-size:18px;font-weight:600;letter-spacing:-.01em}
+.rf-dh span{font-size:12px;color:var(--ia-text-muted)}
+.rf-x{width:32px;height:32px;border-radius:50%;border:0;background:var(--ia-surface-2);color:var(--ia-text);font-size:18px;line-height:1;cursor:pointer}
+.rf-db{flex:1;overflow-y:auto;padding:18px 24px 24px}
+.rf-df{display:flex;align-items:center;gap:10px;padding:14px 24px;border-top:1px solid var(--ia-border)}
+.rf-df .sp{flex:1}
+.rf-saved{font-size:12px;color:var(--sd-t3);opacity:0;transition:opacity .25s}
+.rf-saved.on{opacity:1}
+.rf-fg{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px 12px}
+.rf-fg label{display:flex;flex-direction:column;gap:5px;min-width:0}
+.rf-c2{grid-column:span 2}.rf-c4{grid-column:1/-1}
+.rf-money{position:relative}.rf-money::before{content:'$';position:absolute;left:10px;top:50%;transform:translateY(-50%);font-size:13px;color:var(--ia-text-dim)}
+.rf-money .ia-input{padding-left:22px}
+.rf-dsec{margin:22px 0 10px;padding-top:16px;border-top:1px solid var(--ia-border);font-size:13px;font-weight:600;display:flex;justify-content:space-between;align-items:baseline}
+.rf-dsec:first-child{margin-top:0;padding-top:0;border-top:0}
+.rf-dsec small{font-size:11.5px;font-weight:400;color:var(--ia-text-muted)}
+.rf-photos{display:flex;gap:8px;flex-wrap:wrap}
+.rf-ph{position:relative;width:72px;height:72px;border-radius:12px;background:var(--ia-surface-2) center/cover;border:2px solid transparent;cursor:pointer}
+.rf-ph.main{border-color:var(--ia-accent)}
+.rf-ph b{position:absolute;top:4px;left:4px;width:20px;height:20px;border-radius:50%;display:grid;place-items:center;font-size:11px;background:rgba(0,0,0,.55);color:#fff}
+.rf-ph.main b{background:var(--ia-accent);color:var(--ia-accent-text)}
+.rf-ph.add{display:grid;place-items:center;border:1.5px dashed var(--ia-border-strong);background:none;color:var(--ia-text-dim);font-size:20px}
+.rf-chips{display:flex;gap:6px;flex-wrap:wrap;align-items:center}
+.rf-chip{display:inline-flex;align-items:center;gap:6px;height:30px;padding:0 6px 0 12px;border-radius:99px;background:var(--ia-surface-2);font-size:12.5px;font-weight:600}
+.rf-chip button{width:20px;height:20px;border-radius:50%;border:0;background:none;color:var(--ia-text-dim);cursor:pointer}
+.rf-chip button:hover{background:var(--ia-hover);color:var(--ia-text)}
+.rf-chipin{position:relative}
+.rf-chipin .ia-input{width:150px;height:30px;border-radius:99px;padding:4px 34px 4px 12px}
+.rf-chipin button{position:absolute;right:3px;top:3px;width:24px;height:24px;border-radius:50%;border:0;background:var(--ia-accent);color:var(--ia-accent-text);font-weight:700;cursor:pointer}
+.rf-err{font-size:11.5px;color:var(--sd-bad)}
+.rf-hint{font-size:11.5px;color:var(--ia-text-muted);margin:6px 0 0}
+.rf-ct{padding:12px 0;border-bottom:1px solid var(--ia-border)}
+.rf-ct:last-child{border-bottom:0}
+.rf-ct-h{display:flex;gap:8px;align-items:center;margin-bottom:8px}
+.rf-ct textarea{font-family:var(--ia-font-mono);font-size:12px;line-height:1.7}
+.rf-ct-acts{display:flex;justify-content:flex-end;gap:8px;margin-top:8px}
+
+/* ---------------- bookings list ---------------- */
+.rf-brow{display:grid;grid-template-columns:34px minmax(0,1.2fr) minmax(0,1.05fr) minmax(0,1.55fr) 80px 132px 104px;gap:14px;align-items:center;padding:11px 10px;border-bottom:1px solid var(--ia-border);border-radius:10px;cursor:pointer;color:inherit;text-decoration:none;transition:background .15s}
+.rf-brow:hover{background:var(--ia-hover)}
+.rf-brow .sd-who small{font-family:var(--ia-font-mono)}
+.rf-win-t{font:500 11.5px var(--ia-font-mono);color:var(--ia-text-muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
+.rf-win-t.late b{color:var(--sd-bad)}
+.rf-win-t b{font-weight:600;color:var(--ia-text)}
+.rf-bal{font:600 12.5px var(--ia-font-mono);text-align:right}
+.rf-bal.zero{color:var(--ia-text-dim);font-weight:400}
+.rf-brow .ia-btn{justify-self:end}
+.rf-bh{display:grid;grid-template-columns:34px minmax(0,1.2fr) minmax(0,1.05fr) minmax(0,1.55fr) 80px 132px 104px;gap:14px;padding:0 10px 8px;font-size:10.5px;text-transform:uppercase;letter-spacing:.06em;color:var(--ia-text-dim);font-weight:600;border-bottom:1px solid var(--ia-border-strong)}
+.rf-bh span:nth-child(5){text-align:right}
+.rf-blist{max-height:none!important;overflow:visible!important}
+.rf-pop-list button{display:block;width:100%;text-align:left;border:0;background:none;color:var(--ia-text);font:inherit;font-size:12.5px;padding:7px 8px;border-radius:7px;cursor:pointer}
+.rf-pop-list button:hover,.rf-pop-list button.on{background:var(--ia-hover)}
+
+/* ---------------- booking detail ---------------- */
+.rf-track{display:flex;align-items:center;margin:4px 0 26px}
+.rf-track div{flex:1;display:flex;align-items:center;gap:8px;font-size:12px;color:var(--ia-text-dim);font-weight:600}
+.rf-track div::after{content:'';flex:1;height:2px;border-radius:2px;background:var(--ia-border);margin-right:8px}
+.rf-track div:last-child{flex:none}.rf-track div:last-child::after{display:none}
+.rf-track i{width:22px;height:22px;border-radius:50%;display:grid;place-items:center;font-style:normal;font-size:11px;background:var(--ia-surface-2);color:var(--ia-text-dim);flex:none}
+.rf-track .done{color:var(--ia-text)}.rf-track .done i{background:var(--sd-t3);color:var(--sd-ink)}
+body.ia-theme-c .rf-track .done i{color:#0d0d0d}
+.rf-track .done::after{background:var(--sd-t3)}
+.rf-track .now{color:var(--ia-text)}.rf-track .now i{background:var(--ia-accent);color:var(--ia-accent-text);box-shadow:0 0 0 4px color-mix(in srgb,var(--ia-accent) 25%,transparent)}
+.rf-track .late i{background:var(--sd-bad);color:#fff;box-shadow:0 0 0 4px color-mix(in srgb,var(--sd-bad) 25%,transparent)}
+
+.rf-blk{margin-bottom:30px}
+.rf-line{display:grid;grid-template-columns:40px minmax(0,1fr) 110px 90px;gap:14px;align-items:center;padding:10px 6px;border-bottom:1px solid var(--ia-border)}
+.rf-line .rf-thumb{width:40px;height:40px;border-radius:10px}
+.rf-line b{display:block;font-size:13px;font-weight:600}
+.rf-line small{font-size:11.5px;color:var(--ia-text-muted)}
+.rf-line .amt{font:500 12.5px var(--ia-font-mono);text-align:right}
+.rf-line.addon .rf-thumb{font-size:15px}
+.rf-tot{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:6px 14px;font-size:12.5px;margin:14px 0 0 auto;max-width:300px}
+.rf-tot dt{color:var(--ia-text-muted)} .rf-tot dd{margin:0;text-align:right;font-family:var(--ia-font-mono)}
+.rf-tot .big{font-size:15px;font-weight:600;color:var(--ia-text);padding-top:8px;border-top:1px solid var(--ia-border)}
+.rf-tot .big+dd{font-size:15px;font-weight:600;padding-top:8px;border-top:1px solid var(--ia-border)}
+.rf-tot .owe,.rf-tot .owe+dd{color:var(--sd-bad);font-weight:600}
+.rf-rail .rf-tot{max-width:none;margin:8px 0 0}
+.rf-linkbtn{border:0;background:none;color:var(--ia-text-muted);font:inherit;font-size:12.5px;cursor:pointer;padding:0;text-decoration:underline;text-underline-offset:3px}
+.rf-linkbtn:hover{color:var(--ia-text)}
+.rf-pay{display:grid;grid-template-columns:minmax(0,1fr) auto auto;gap:14px;align-items:center;padding:9px 6px;border-bottom:1px solid var(--ia-border);font-size:12.5px}
+.rf-pay small{display:block;font-size:11.5px;color:var(--ia-text-muted)}
+.rf-collect{display:flex;gap:8px;align-items:center;margin-top:12px;flex-wrap:wrap}
+.rf-collect .rf-money{width:130px}
+.rf-collect .ia-input{height:32px}
+
+/* rail sections */
+.rf-rh{display:flex;justify-content:space-between;align-items:baseline;gap:10px;margin:24px 0 10px;padding-top:18px;border-top:1px solid var(--ia-border);font-size:13px}
+.rf-rh:first-child{margin-top:0;padding-top:0;border-top:0}
+.rf-rh span{font-size:12px;color:var(--ia-text-muted)}
+.rf-person{display:flex;gap:12px;align-items:center}
+.rf-person .sd-av{width:40px;height:40px;font-size:13px}
+.rf-person b{display:block;font-size:14px;font-weight:600}
+.rf-person small{display:block;font-size:12px;color:var(--ia-text-muted)}
+.rf-kv{display:grid;grid-template-columns:96px minmax(0,1fr);gap:7px 12px;font-size:12.5px;margin:12px 0 0}
