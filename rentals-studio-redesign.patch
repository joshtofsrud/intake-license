+.rf-radio{display:flex;flex-direction:column;gap:8px}
+
+.rf-prog{list-style:none;margin:0;padding:0}
+.rf-prog li{display:flex;align-items:center;gap:10px;padding:6px 0;font-size:12.5px;color:var(--ia-text-muted)}
