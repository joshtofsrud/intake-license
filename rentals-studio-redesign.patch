+body:not(.ia-theme-c) .rf-cu-st.ok{color:color-mix(in srgb,var(--sd-t3) 60%,#000)}
+
+.rf-charge{display:grid;grid-template-columns:minmax(0,1fr) 150px 120px 24px;gap:10px;align-items:center;padding:8px 0;border-bottom:1px dashed var(--ia-border)}
