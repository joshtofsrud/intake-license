+
+/* ---------------- fleet: the live page's own pieces ---------------- */
+/* header search is a real GET form, styled like the Desk's search button */
+.rf-sform{display:flex;align-items:center;gap:8px;height:32px;padding:0 10px;min-width:250px;border:1px solid var(--ia-border);border-radius:8px;background:var(--ia-input-bg);color:var(--ia-text-muted)}
+.rf-sform:focus-within{border-color:var(--ia-border-strong);color:var(--ia-text)}
