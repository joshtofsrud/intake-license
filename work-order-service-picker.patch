From 92638d9aa8d912a46e55850d77b896db25894c81 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sat, 7 Nov 2026 09:23:30 -0800
Subject: [PATCH] New appointment: the service picker matches Add service on
 the work order, with category pills and name, length, category and price

---
 .../Tenant/AppointmentController.php          |  5 +-
 .../appointments/_create_modal.blade.php      | 58 +++++++++++++++----
 2 files changed, 51 insertions(+), 12 deletions(-)

diff --git a/app/Http/Controllers/Tenant/AppointmentController.php b/app/Http/Controllers/Tenant/AppointmentController.php
index ac1c1e70..20373532 100644
--- a/app/Http/Controllers/Tenant/AppointmentController.php
+++ b/app/Http/Controllers/Tenant/AppointmentController.php
@@ -449,8 +449,11 @@ class AppointmentController extends Controller
         $services = \App\Models\Tenant\TenantServiceItem::where('tenant_id', $tenant->id)
             ->where('is_active', true)
             ->orderBy('sort_order')->orderBy('name')
+            ->with('category:id,name')
             ->get(['id', 'name', 'duration_minutes', 'price_cents',
-                   'prep_before_minutes', 'cleanup_after_minutes']);
+                   'prep_before_minutes', 'cleanup_after_minutes', 'category_id']);
+        // MARKER-MULTI-ASSET-MODAL: the category name, for the picker's category pills
+        $services->each(fn ($s) => $s->setAttribute('category_name', $s->category?->name ?? 'Other'))->makeHidden(['category', 'category_id']);
 
         $customersQuery = TenantCustomer::where('tenant_id', $tenant->id);
         if ($search !== '') {
diff --git a/resources/views/tenant/appointments/_create_modal.blade.php b/resources/views/tenant/appointments/_create_modal.blade.php
index a8a538d1..3e25c58a 100644
--- a/resources/views/tenant/appointments/_create_modal.blade.php
+++ b/resources/views/tenant/appointments/_create_modal.blade.php
@@ -291,8 +291,26 @@
     .wi-svcline select { flex: 1; min-width: 0; }
     .wi-ta { position: relative; flex: 1; min-width: 0; }
     .wi-ta-in { width: 100%; text-overflow: ellipsis; }
-    .wi-ta-res { position: absolute; left: 0; right: 0; top: 100%; z-index: 30; max-height: 260px; box-shadow: 0 12px 28px rgba(0,0,0,.35); }
-    .wi-ta-res .appt-cust-row.on { background: rgba(255,255,255,.08); }
+    /* the service picker panel, in the look of Add service on the work order */
+    .wi-ta-res { position: absolute; left: 0; top: calc(100% + 4px); z-index: 30; width: max(100%, 380px); max-width: min(460px, calc(100vw - 48px)); padding: 10px; border-radius: 10px;
+      background: var(--ia-surface, #1c1c1c); border: 1px solid var(--ia-border-strong, rgba(255,255,255,.22)); box-shadow: 0 14px 34px rgba(0,0,0,.4); }
+    .wi-cat-rail { display: flex; gap: 6px; overflow-x: auto; padding: 0 0 10px; scrollbar-width: none; }
+    .wi-cat-rail::-webkit-scrollbar { display: none; }
+    .wi-cat-pill { flex: none; padding: 6px 11px; border-radius: 99px; border: .5px solid var(--ia-border, rgba(255,255,255,.14)); background: transparent; color: var(--ia-text, #f0f0f0); opacity: .72; font: inherit; font-size: 12px; font-weight: 600; white-space: nowrap; cursor: pointer; }
+    .wi-cat-pill:hover { opacity: 1; border-color: var(--ia-border-strong, rgba(255,255,255,.22)); }
+    .wi-cat-pill.on { background: var(--ia-accent, #BEF264); color: var(--ia-accent-text, #0a0a0a); border-color: var(--ia-accent, #BEF264); opacity: 1; }
+    .wi-cat-pill span { opacity: .55; font-size: 11px; margin-left: 3px; }
+    .wi-cat-list { max-height: 280px; overflow-y: auto; border: 1px solid var(--ia-border, rgba(255,255,255,.12)); border-radius: 6px; }
+    .wi-cat-row { display: flex; align-items: center; gap: 12px; padding: 9px 12px; border-bottom: .5px solid var(--ia-border, rgba(255,255,255,.12)); cursor: pointer; }
+    .wi-cat-row:last-child { border-bottom: 0; }
+    .wi-cat-row:hover, .wi-cat-row.on { background: var(--ia-hover, rgba(255,255,255,.05)); }
+    .wi-cat-row.on { box-shadow: inset 2px 0 0 var(--ia-accent, #BEF264); }
+    .wi-cat-main { flex: 1; min-width: 0; }
+    .wi-cat-name { font-size: 13px; }
+    .wi-cat-meta { font-size: 11px; color: var(--ia-text-dim, rgba(255,255,255,.5)); margin-top: 1px; }
+    .wi-cat-price { font-size: 13px; font-variant-numeric: tabular-nums; }
+    .wi-cat-none { padding: 14px 12px; font-size: 12.5px; opacity: .6; }
+    @media (max-width: 640px) { .wi-ta-res { width: auto; right: 0; } }
     .wi-x { background: none; border: 0; color: var(--ia-text-dim, rgba(255,255,255,.5)); font-size: 18px; line-height: 1; cursor: pointer; padding: 25px 0 0; border-radius: 6px; }
     .wi-x:hover { color: var(--ia-text, #fff); }
     .wi-x[disabled] { visibility: hidden; }
@@ -816,24 +834,39 @@ window.ApptModal = (function () {
     });
     // service search: focus lists every service, typing narrows it, arrows and Enter pick
     var ta = null; // { input, i, k, hi }
+    // the same picker as Add service on the work order: category pills, then name, length · category, price
+    function taCats() {
+      var c = {};
+      state.services.forEach(function (x) { var k = x.category_name || 'Other'; c[k] = (c[k] || 0) + 1; });
+      return Object.keys(c).sort().map(function (k) { return [k, c[k]]; });
+    }
     function taList(q) {
       q = (q || '').trim().toLowerCase();
       var list = state.services.slice().sort(function (a, b) { return a.name.localeCompare(b.name); });
-      return q ? list.filter(function (x) { return x.name.toLowerCase().indexOf(q) > -1; }) : list;
+      if (ta && ta.cat) list = list.filter(function (x) { return (x.category_name || 'Other') === ta.cat; });
+      return q ? list.filter(function (x) { return x.name.toLowerCase().indexOf(q) > -1 || (x.category_name || '').toLowerCase().indexOf(q) > -1; }) : list;
     }
     function taRender() {
       if (!ta) return;
       var wrap = ta.input.parentNode, res = wrap.querySelector('.wi-ta-res');
-      if (!res) { res = document.createElement('div'); res.className = 'appt-cust-results wi-ta-res'; res.setAttribute('role', 'listbox'); wrap.appendChild(res); }
+      if (!res) { res = document.createElement('div'); res.className = 'wi-ta-res'; wrap.appendChild(res); }
       var q = ta.input.value === ta.label ? '' : ta.input.value;
       var list = taList(q);
       if (ta.hi >= list.length) ta.hi = list.length - 1;
-      res.innerHTML = list.length ? list.map(function (x, n) {
-        return '<div class="appt-cust-row' + (n === ta.hi ? ' on' : '') + '" role="option" data-id="' + esc(x.id) + '"><div>' + esc(x.name) + '</div><div class="meta">' + esc(svcMeta(x)) + '</div></div>';
-      }).join('') : '<div class="appt-cust-row" style="cursor:default;opacity:.55">No services match “' + esc(q) + '”.</div>';
+      var cats = taCats();
+      res.innerHTML = (cats.length > 1 ? '<div class="wi-cat-rail">' + '<button type="button" class="wi-cat-pill' + (!ta.cat ? ' on' : '') + '" data-cat="">All <span>' + state.services.length + '</span></button>'
+          + cats.map(function (c) { return '<button type="button" class="wi-cat-pill' + (ta.cat === c[0] ? ' on' : '') + '" data-cat="' + esc(c[0]) + '">' + esc(c[0]) + ' <span>' + c[1] + '</span></button>'; }).join('') + '</div>' : '')
+        + '<div class="wi-cat-list" role="listbox">' + (list.length ? list.map(function (x, n) {
+          var meta = [x.duration_minutes ? x.duration_minutes + ' min' : '', x.category_name || ''].filter(Boolean).join(' · ');
+          return '<div class="wi-cat-row' + (n === ta.hi ? ' on' : '') + '" role="option" data-id="' + esc(x.id) + '"><div class="wi-cat-main"><div class="wi-cat-name">' + esc(x.name) + '</div>' + (meta ? '<div class="wi-cat-meta">' + esc(meta) + '</div>' : '') + '</div><div class="wi-cat-price">' + (x.price_cents != null ? fmt(x.price_cents) : '') + '</div></div>';
+        }).join('') : '<div class="wi-cat-none">No services match' + (q ? ' “' + esc(q) + '”' : '') + (ta.cat ? ' in ' + esc(ta.cat) : '') + '.</div>') + '</div>';
       ta.list = list;
       ta.input.setAttribute('aria-expanded', 'true');
-      var on = res.querySelector('.on'); if (on && on.scrollIntoView) on.scrollIntoView({ block: 'nearest' });
+      var on = res.querySelector('.wi-cat-row.on'); if (on && on.scrollIntoView) on.scrollIntoView({ block: 'nearest' });
+      // keep the panel inside the window: open leftward when there's no room on the right
+      res.style.left = ''; res.style.right = '';
+      var card = el('new-appt-card'), cr = card ? card.getBoundingClientRect() : { right: innerWidth };
+      if (res.getBoundingClientRect().right > cr.right - 12) { res.style.left = 'auto'; res.style.right = '0'; }
     }
     function taClose(restore) {
       if (!ta) return;
@@ -853,7 +886,7 @@ window.ApptModal = (function () {
       if (!e.target.classList.contains('wi-ta-in')) return;
       if (ta && ta.input !== e.target) taClose(true);
       var row = e.target.closest('.wi-row');
-      ta = { input: e.target, i: +row.dataset.i, k: +e.target.dataset.k, hi: -1, label: e.target.value, list: [] };
+      ta = { input: e.target, i: +row.dataset.i, k: +e.target.dataset.k, hi: -1, label: e.target.value, list: [], cat: '' };
       e.target.select();
       taRender();
     });
@@ -862,8 +895,11 @@ window.ApptModal = (function () {
       setTimeout(function () { if (ta && document.activeElement !== ta.input) taClose(true); }, 150);
     });
     box.addEventListener('mousedown', function (e) {
-      var opt = e.target.closest('.wi-ta-res .appt-cust-row[data-id]');
-      if (opt) { e.preventDefault(); taPick(opt.dataset.id); }
+      var pill = e.target.closest('.wi-ta-res .wi-cat-pill');
+      if (pill && ta) { e.preventDefault(); ta.cat = pill.dataset.cat; ta.hi = 0; taRender(); return; }
+      var opt = e.target.closest('.wi-ta-res .wi-cat-row[data-id]');
+      if (opt) { e.preventDefault(); taPick(opt.dataset.id); return; }
+      if (e.target.closest('.wi-ta-res')) e.preventDefault(); // scrolling the panel keeps the search focused
     });
     box.addEventListener('keydown', function (e) {
       if (!ta || e.target !== ta.input) return;
-- 
2.43.0

