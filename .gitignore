# ===== Laravel runtime / generated =====
/vendor
/node_modules
/public/build
/public/hot
/public/storage

# Bootstrap cache (regenerated by `composer install` and `php artisan optimize`)
/bootstrap/cache/*.php

# Storage (logs, sessions, compiled views, file uploads)
/storage/*.key
/storage/app/public/*
/storage/app/uploads/*
/storage/debugbar
/storage/framework/cache/data/*
/storage/framework/sessions/*
/storage/framework/testing/*
/storage/framework/views/*
/storage/logs/*
!/storage/app/.gitkeep
!/storage/app/public/.gitkeep
!/storage/framework/cache/.gitkeep
!/storage/framework/sessions/.gitkeep
!/storage/framework/views/.gitkeep
!/storage/logs/.gitkeep

# ===== Filament (admin panel auto-published assets, regenerated on deploy) =====
/public/css/filament
/public/js/filament

# ===== Env / secrets =====
.env
.env.backup
.env.production
.phpunit.result.cache

# ===== IDE / OS =====
.idea
.vscode
.fleet
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
ehthumbs.db
Icon?

# ===== Build artifacts =====
yarn-error.log
npm-debug.log
.npm
.yarn
.pnpm-store
.composer

# ===== Misc accidental files =====
*.bak
*.backup
*.swp
*~
# Tinker-saved-as-file accidents (e.g. "Tenant::where('subdomain'...")
Tenant::*
/patch-*.sh
