@@ -0,0 +1,75 @@
+<?php
+
+namespace App\Support\Dashboard;
+
+/**
+ * The dashboard blocks that come from code.
+ *
+ * Each one is a Blade partial that draws one part of a dashboard, plus the
+ * extra data it needs beyond what every dashboard already loads (greeting,
+ * today, attention, growth, launcher, progress). Templates arrange these by
+ * key; the dashboard_blocks table holds the master-admin side of each one
+ * (its name, and whether it's hidden everywhere).
+ *
+ * Adding a built-in block: add an entry here and a row in dashboard_blocks
+ * (see DashboardTemplates::seedBuiltIns()).
+ */
+class BlockRegistry
+{
+    /** Extra data a block can ask for, and what loads it. */
+    public const NEEDS = ['week', 'jobs', 'tiles'];
+
+    public static function builtIns(): array
+    {
+        return [
+            // Overview
+            'attention' => ['name' => 'Needs attention', 'origin' => 'overview', 'view' => 'tenant.dashboard._zone_triage_tiles',
+                'reads' => 'Appointments, work orders, special orders, stock', 'desc' => 'The attention counts as a row of tiles.', 'needs' => []],
+            'today'     => ['name' => 'Today', 'origin' => 'overview', 'view' => 'tenant.dashboard._zone_today_tile',
+                'reads' => 'Appointments', 'desc' => "Today's bookings and the week strip.", 'needs' => []],
+            'growth'    => ['name' => 'Growth', 'origin' => 'overview', 'view' => 'tenant.dashboard._zone_growth_tiles',
+                'reads' => 'Sales, customers', 'desc' => 'Revenue and customer trends.', 'needs' => []],
+            'launcher'  => ['name' => 'App launcher', 'origin' => 'overview', 'view' => 'tenant.dashboard._zone_launcher',
+                'reads' => 'Add-ons the shop has', 'desc' => 'Shortcuts to the main areas.', 'needs' => []],
+
+            // Tiles
+            'needs_you' => ['name' => 'Needs you', 'origin' => 'tiles', 'view' => 'tenant.dashboard.blocks.needs-you',
+                'reads' => 'Appointments, work orders, special orders, stock', 'desc' => 'Attention counts as tiles, collapsible.', 'needs' => []],
+            'tiles'     => ['name' => 'Tiles', 'origin' => 'tiles', 'view' => 'tenant.dashboard.blocks.tiles',
+                'reads' => 'Add-ons the shop has', 'desc' => 'Shortcut tiles each person can reorder and hide.', 'needs' => ['tiles']],
+
+            // Brief
+            'greeting'  => ['name' => 'Greeting and summary', 'origin' => 'brief', 'view' => 'tenant.dashboard.blocks.greeting',
+                'reads' => 'Appointments, the queue', 'desc' => 'Greeting, then one line on what is late, due and booked.', 'needs' => []],
+            'actions'   => ['name' => 'Quick actions', 'origin' => 'brief', 'view' => 'tenant.dashboard.blocks.actions',
+                'reads' => 'Shop settings', 'desc' => 'New appointment, plus Open register when Retail is on.', 'needs' => []],
+            'setup'     => ['name' => 'Finish setup', 'origin' => 'brief', 'view' => 'tenant.dashboard.blocks.setup',
+                'reads' => 'Setup progress', 'desc' => 'Shows until services, hours and branding are done.', 'needs' => []],
+            'queue'     => ['name' => 'The queue', 'origin' => 'brief', 'view' => 'tenant.dashboard.blocks.queue',
+                'reads' => 'Appointments, work orders, special orders, stock', 'desc' => 'Late, Today and When you can. Each row opens its list.', 'needs' => []],
+            'week'      => ['name' => 'This week', 'origin' => 'brief', 'view' => 'tenant.dashboard.blocks.week',
+                'reads' => 'Appointments, opening hours', 'desc' => 'Day strip and timeline. Free time links to a new appointment.', 'needs' => ['week']],
+            'last30'    => ['name' => 'Last 30 days', 'origin' => 'brief', 'view' => 'tenant.dashboard.blocks.last30',
+                'reads' => 'Sales, work orders, customers', 'desc' => 'Sales, jobs completed and new customers against the 30 days before.', 'needs' => ['jobs']],
+        ];
+    }
+
+    public static function view(string $key): ?string
+    {
+        return self::builtIns()[$key]['view'] ?? null;
+    }
+
+    /** Every extra data set the blocks in these rows ask for. */
+    public static function needs(array $rows): array
+    {
+        $defs = self::builtIns();
+        $needs = [];
+        foreach (Layout::blockKeys($rows) as $key) {
+            foreach ($defs[$key]['needs'] ?? [] as $n) {
+                $needs[$n] = true;
+            }
+        }
+
+        return array_keys($needs);
+    }
+}
diff --git a/app/Support/Dashboard/BriefView.php b/app/Support/Dashboard/BriefView.php
new file mode 100644
index 00000000..4491c7e6
--- /dev/null
+++ b/app/Support/Dashboard/BriefView.php
@@ -0,0 +1,125 @@
+<?php
+
+namespace App\Support\Dashboard;
+
+use Illuminate\Support\Collection;
+use Illuminate\Support\Str;
+
+/**
+ * The figures and small renderers the Brief blocks share.
+ *
+ * These used to sit in one @php block at the top of dashboard-brief.blade.php.
+ * Now that each part of Brief is its own block (so a template can use any of
+ * them on its own), every block asks this class for what it needs instead of
+ * relying on variables another block happened to set.
+ */
+class BriefView
+{
+    private const LATE_KEYS  = ['overdue_unstarted', 'overdue_in_progress', 'so_overdue'];
+    private const LATER_KEYS = ['so_needed', 'low_stock', 'catalog_attention', 'custom_items', 'win_back', 'transfers_arriving'];
+
+    /**
+     * The attention cards grouped by urgency: Late, Today, When you can.
+     *
+     * @return array{cards: Collection, groups: array, lateN: int, todayN: int}
+     */
+    public static function queue(?array $attention): array
+    {
+        $cards  = collect($attention['cards'] ?? [])->filter(fn ($c) => (int) ($c['count'] ?? 0) > 0);
+        $groups = [
+            'late'  => ['Late',         $cards->filter(fn ($c) => in_array($c['key'] ?? '', self::LATE_KEYS, true))],
+            'today' => ['Today',        $cards->reject(fn ($c) => in_array($c['key'] ?? '', array_merge(self::LATE_KEYS, self::LATER_KEYS), true))],
+            'later' => ['When you can', $cards->filter(fn ($c) => in_array($c['key'] ?? '', self::LATER_KEYS, true))],
+        ];
+
+        return [
+            'cards'  => $cards,
+            'groups' => $groups,
+            'lateN'  => (int) $groups['late'][1]->sum('count'),
+            'todayN' => (int) $groups['today'][1]->sum('count'),
+        ];
+    }
+
+    public static function hello(array $greeting): string
+    {
+        return 'Good ' . $greeting['time_of_day'] . ($greeting['name'] ? ', ' . $greeting['name'] : '') . '.';
+    }
+
+    public static function dayLine(?array $today): string
+    {
+        $booked = $today['today_count'] ?? 0;
+        if ($booked > 0) {
+            return $booked . ' ' . Str::plural('booking', $booked) . ' today.';
+        }
+        if (! empty($today['next_day'])) {
+            return 'Nothing is booked until ' . ($today['next_day']->isTomorrow() ? 'tomorrow' : $today['next_day']->format('l')) . '.';
+        }
+
+        return 'Nothing is booked in the next 30 days.';
+    }
+
+    /**
+     * Setup progress: how many of the three steps are done and the next one.
+     *
+     * @return array{done: int, next: ?array}
+     */
+    public static function setup(?array $progress): array
+    {
+        $steps = [
+            'services' => ['Add your services', route('tenant.services.index')],
+            'hours'    => ['Set your hours', route('tenant.capacity.index')],
+            'branding' => ['Add your logo and colours', route('tenant.settings.index')],
+        ];
+
+        return [
+            'done' => collect($steps)->keys()->filter(fn ($k) => ! empty($progress[$k]))->count(),
+            'next' => collect($steps)->first(fn ($v, $k) => empty($progress[$k])),
+        ];
+    }
+
+    /** The day the week opens on: today if it has bookings, else the first day that does. */
+    public static function firstBusyDay(array $days): int
+    {
+        if (empty($days[0]['bookings']) && empty($days[0]['untimed'])) {
+            foreach ($days as $i => $d) {
+                if ($d['bookings'] || $d['untimed']) {
+                    return $i;
+                }
+            }
+        }
+
+        return 0;
+    }
+
+    /** 9 → "9a", 13.5 → "1:30p". */
+    public static function hour(float $h): string
+    {
+        $H = (int) floor($h);
+        $M = (int) round(($h - $H) * 60);
+        if ($M === 60) { $H++; $M = 0; }
+
+        return ((($H + 11) % 12) + 1) . ($M ? ':' . str_pad((string) $M, 2, '0', STR_PAD_LEFT) : '') . ($H < 12 ? 'a' : 'p');
+    }
+
+    /** A 4-day moving-average sparkline, or an empty box when there's nothing to draw. */
+    public static function spark(array $vals): string
+    {
+        $vals = array_values($vals);
+        $n = count($vals);
+        if ($n < 2 || max($vals) == min($vals)) return '<svg viewBox="0 0 110 28" aria-hidden="true"></svg>';
+        $avg = [];
+        for ($i = 0; $i < $n; $i++) { $w = array_slice($vals, max(0, $i - 3), min(4, $i + 1)); $avg[] = array_sum($w) / count($w); }
+        $mn = min($avg); $mx = max($avg); $pts = [];
+        foreach ($avg as $i => $v) { $pts[] = round($i * 110 / ($n - 1), 1) . ',' . round(25 - ($mx > $mn ? ($v - $mn) / ($mx - $mn) : .5) * 22, 1); }
+        $last = explode(',', end($pts));
+
+        return '<svg viewBox="0 0 110 28" aria-hidden="true"><path d="M' . implode(' L', $pts) . '" fill="none" stroke="currentColor" stroke-opacity=".75" stroke-width="1.5" stroke-linejoin="round" stroke-linecap="round"/><circle cx="' . $last[0] . '" cy="' . $last[1] . '" r="2.2" fill="currentColor"/></svg>';
+    }
+
+    public static function delta($pct): string
+    {
+        if ($pct === null) return '';
+
+        return '<small class="' . ($pct >= 0 ? 'up' : 'down') . '">' . ($pct >= 0 ? '▲ ' : '▼ ') . abs($pct) . '% vs the 30 days before</small>';
+    }
+}
diff --git a/app/Support/Dashboard/DashboardTemplates.php b/app/Support/Dashboard/DashboardTemplates.php
new file mode 100644
index 00000000..a080dbf4
--- /dev/null
+++ b/app/Support/Dashboard/DashboardTemplates.php
@@ -0,0 +1,174 @@
+<?php
+
+namespace App\Support\Dashboard;
+
+use App\Models\DashboardBlock;
+use App\Models\DashboardTemplate;
+use Illuminate\Support\Facades\DB;
+
+/**
+ * Which dashboard templates a person can switch between, and which one they
+ * see. Reads dashboard_templates / their live versions; if those tables can't
+ * be read (a migration hasn't run yet) it falls back to the built-in
+ * definitions below, which are exactly what the tables are seeded with — so
+ * a shop's dashboard never breaks over it.
+ */
+class DashboardTemplates
+{
+    /** The frame is the page around the blocks: its header, switch and scripts. */
+    public const FRAMES = [
+        'overview' => 'tenant.dashboard',
+        'tiles'    => 'tenant.dashboard-tiles',
+        'brief'    => 'tenant.dashboard-brief',
+    ];
+
+    /** Switch icons. The same SVGs the three views drew by hand before. */
+    public const ICONS = [
+        'overview' => '<svg class="vs-ic" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><rect x="3" y="5" width="14" height="14" rx="2"/><path d="M21 7v10"/></svg>',
+        'tiles'    => '<svg class="vs-ic" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg>',
+        'brief'    => '<svg class="vs-ic" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 6h16M4 12h10M4 18h13"/></svg>',
+    ];
+
+    private static ?array $cache = null;
+
+    /**
+     * Overview, Tiles and Brief as templates: the same blocks, in the same
+     * order, as the three views drew before templates existed.
+     */
+    public static function builtInDefinitions(): array
+    {
+        $p = fn (string $b) => ['b' => $b];
+
+        return [
+            ['key' => 'overview', 'name' => 'Overview', 'frame' => 'overview', 'switch_label' => 'Overview', 'beta_badge' => false,
+             'icon' => 'overview', 'is_default' => true, 'sort' => 10, 'state' => 'live', 'rearrange' => 'none',
+             'layout' => [
+                 ['split' => [12], 'cols' => [[$p('attention')]]],
+                 ['split' => [12], 'cols' => [[$p('today')]]],
+                 ['split' => [12], 'cols' => [[$p('growth')]]],
+                 ['split' => [12], 'cols' => [[$p('launcher')]]],
+             ]],
+            ['key' => 'tiles', 'name' => 'Tiles', 'frame' => 'tiles', 'switch_label' => 'Tiles', 'beta_badge' => false,
+             'icon' => 'tiles', 'is_default' => false, 'sort' => 20, 'state' => 'live', 'rearrange' => 'none',
+             'layout' => [
+                 ['split' => [12], 'cols' => [[$p('needs_you')]]],
+                 ['split' => [12], 'cols' => [[$p('tiles')]]],
+             ]],
+            ['key' => 'brief', 'name' => 'Brief', 'frame' => 'brief', 'switch_label' => 'Brief', 'beta_badge' => true,
+             'icon' => 'brief', 'is_default' => false, 'sort' => 30, 'state' => 'live', 'rearrange' => 'none',
+             'layout' => [
+                 ['split' => [12], 'cols' => [[$p('greeting'), $p('actions'), $p('setup')]]],
+                 ['split' => [7, 5], 'cols' => [[$p('queue')], [$p('week'), $p('last30')]]],
+             ]],
+        ];
+    }
+
+    /** Writes the built-in blocks and templates (v1 of each). Safe to run twice. */
+    public static function seedBuiltIns(): void
+    {
+        $now = now();
+
+        foreach (BlockRegistry::builtIns() as $key => $def) {
+            DB::table('dashboard_blocks')->updateOrInsert(
+                ['key' => $key],
+                ['name' => $def['name'], 'kind' => 'data', 'is_builtin' => true, 'origin' => $def['origin'], 'created_at' => $now, 'updated_at' => $now]
+            );
+        }
+
+        foreach (self::builtInDefinitions() as $def) {
+            if (DB::table('dashboard_templates')->where('key', $def['key'])->exists()) {
+                continue;
+            }
+            $id = DB::table('dashboard_templates')->insertGetId([
+                'key' => $def['key'], 'name' => $def['name'], 'is_builtin' => true, 'frame' => $def['frame'],
+                'state' => $def['state'], 'switch_label' => $def['switch_label'], 'beta_badge' => $def['beta_badge'],
+                'icon' => $def['icon'], 'rearrange' => $def['rearrange'], 'is_default' => $def['is_default'],
+                'sort' => $def['sort'], 'created_at' => $now, 'updated_at' => $now,
+            ]);
+            $vid = DB::table('dashboard_template_versions')->insertGetId([
+                'dashboard_template_id' => $id, 'version' => 1, 'layout' => json_encode($def['layout']),
+                'note' => 'Made a template from the ' . $def['name'] . ' view. Nothing changed on screen.',
+                'published_at' => $now, 'created_at' => $now, 'updated_at' => $now,
+            ]);
+            DB::table('dashboard_templates')->where('id', $id)->update(['live_version_id' => $vid]);
+        }
+    }
+
+    /**
+     * Templates that appear in the dashboard switch, in order, each with its
+     * live layout (hidden and unknown blocks already taken out).
+     *
+     * @return array<int, array{key: string, name: string, frame: string, label: string, beta: bool, icon: string, default: bool, rows: array}>
+     */
+    public static function switchable(): array
+    {
+        if (self::$cache !== null) {
+            return self::$cache;
+        }
+
+        try {
+            $hidden = DashboardBlock::whereNotNull('hidden_at')->pluck('key')->all();
+            $list = DashboardTemplate::with('liveVersion')
+                ->whereIn('state', ['live', 'beta'])
+                ->whereNotNull('live_version_id')
+                ->whereIn('frame', array_keys(self::FRAMES))
+                ->orderBy('sort')->orderBy('id')
+                ->get()
+                ->map(fn (DashboardTemplate $t) => [
+                    'key'     => $t->key,
+                    'name'    => $t->name,
+                    'frame'   => $t->frame,
+                    'label'   => $t->switch_label ?: $t->name,
+                    'beta'    => (bool) $t->beta_badge,
+                    'icon'    => $t->icon ?: $t->frame,
+                    'default' => (bool) $t->is_default,
+                    'rows'    => Layout::visible((array) ($t->liveVersion?->layout ?? []), $hidden),
+                ])
+                ->values()
+                ->all();
+        } catch (\Throwable $e) {
+            report($e);
+            $list = [];
+        }
+
+        if (! $list) {
+            $list = array_map(fn ($d) => [
+                'key' => $d['key'], 'name' => $d['name'], 'frame' => $d['frame'], 'label' => $d['switch_label'],
+                'beta' => $d['beta_badge'], 'icon' => $d['icon'], 'default' => $d['is_default'],
+                'rows' => Layout::visible($d['layout']),
+            ], self::builtInDefinitions());
+        }
+
+        return self::$cache = $list;
+    }
+
+    /** The template this person sees: the one they picked, else the default, else the first. */
+    public static function activeFor(?string $picked): array
+    {
+        $list = self::switchable();
+        foreach ($list as $t) {
+            if ($picked !== null && $t['key'] === $picked) return $t;
+        }
+        foreach ($list as $t) {
+            if ($t['default']) return $t;
+        }
+
+        return $list[0];
+    }
+
+    public static function keys(): array
+    {
+        return array_column(self::switchable(), 'key');
+    }
+
+    public static function frameView(array $template): string
+    {
+        return self::FRAMES[$template['frame']] ?? self::FRAMES['overview'];
+    }
+
+    /** For tests and long-running workers: forget what this process read. */
+    public static function flush(): void
+    {
+        self::$cache = null;
+    }
+}
