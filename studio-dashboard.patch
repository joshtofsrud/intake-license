+body.ia-theme-c .sd-stack .p2, body.ia-theme-c .sd-key .p2 { background: color-mix(in srgb, var(--c) 50%, transparent); }
+body.ia-theme-c .sd-stack .p3, body.ia-theme-c .sd-key .p3 { background: var(--c); color: #0d0d0d; }
+.sd-key { display: flex; gap: 12px; flex-wrap: wrap; font-size: 11px; opacity: .75; }
+.sd-key i { display: inline-block; width: 8px; height: 8px; border-radius: 2px; margin-right: 5px; }
+.sd-ring { display: flex; align-items: center; gap: 14px; margin-top: auto; }
