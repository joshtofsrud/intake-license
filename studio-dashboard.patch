+.sd-ring circle { fill: none; stroke: color-mix(in srgb, var(--sd-ink) 14%, transparent); stroke-width: 4; }
+.sd-ring circle.v { stroke: var(--sd-ink); stroke-linecap: round; stroke-dasharray: var(--p) 100; transition: stroke-dasharray 1.1s ease; transition-delay: calc(var(--d, 0ms) + 300ms); }
+body.ia-theme-c .sd-ring circle { stroke: rgba(255, 255, 255, .1); } body.ia-theme-c .sd-ring circle.v { stroke: var(--c); }
