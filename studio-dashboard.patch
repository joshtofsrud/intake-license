+.sd-st { font-size: 11px; font-weight: 600; padding: 3px 9px; border-radius: 99px; text-align: center; background: color-mix(in srgb, var(--c) 42%, transparent); color: var(--sd-ink); }
+body.ia-theme-c .sd-st { background: color-mix(in srgb, var(--c) 16%, transparent); color: var(--c); }
+.sd-st.late { background: color-mix(in srgb, var(--sd-bad) 16%, transparent); color: var(--sd-bad); }
+.sd-age { font: 500 11.5px var(--ia-font-mono); color: var(--ia-text-dim); text-align: right; }
+.sd-more { display: inline-block; margin-top: 10px; }
+@media (min-width: 1024px) { .sd-list { max-height: 600px; overflow-y: auto; overscroll-behavior: contain; scrollbar-width: thin; } }
+.sd-none { padding: 18px 4px; font-size: 12.5px; color: var(--ia-text-muted); }
+/* rows below the fold come in soft and sharpen */
+.sd-blur { filter: blur(6px); opacity: 0; transform: translateY(10px); }
+
+/* multi-asset count and its list */
+.sd-multi { flex: none; font: inherit; font-size: 11px; font-weight: 700; padding: 1px 8px; border-radius: 99px; border: 1px solid var(--ia-border-strong); background: var(--ia-surface); color: var(--ia-text); cursor: help; }
+.sd-multi:hover, .sd-multi:focus-visible { border-color: var(--ia-text); outline: none; }
+.sd-pop { position: fixed; z-index: 120; min-width: 240px; max-width: 340px; padding: 10px 12px; border-radius: 12px; font-size: 12.5px;
+  background: var(--ia-surface); border: 1px solid var(--ia-border-strong); box-shadow: 0 12px 32px rgba(0, 0, 0, .2); }
+.sd-pop h4 { font-size: 10.5px; text-transform: uppercase; letter-spacing: .06em; color: var(--ia-text-dim); font-weight: 600; margin: 0 0 6px; }
+.sd-pop div { padding: 6px 0; border-top: 1px solid var(--ia-border); }
+.sd-pop div:first-of-type { border-top: 0; }
+.sd-pop b { display: flex; justify-content: space-between; gap: 12px; font-weight: 600; }
+.sd-pop b span { font: 500 11px var(--ia-font-mono); color: var(--ia-text-muted); white-space: nowrap; }
+.sd-pop small { display: block; color: var(--ia-text-muted); font-size: 11.5px; margin-top: 2px; }
+
+/* detail */
+.sd-detail { margin-top: 20px; padding: 20px 22px; border-radius: 18px; background: color-mix(in srgb, var(--sd-t2) 20%, var(--ia-surface)); transition: opacity .15s; }
+body.ia-theme-c .sd-detail { background: color-mix(in srgb, var(--sd-t2) 8%, var(--ia-surface)); box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--sd-t2) 16%, transparent); }
+.sd-detail.swap { opacity: .25; }
+.sd-detail h3 { font-size: 16px; font-weight: 600; display: flex; justify-content: space-between; gap: 10px; margin: 0; }
+.sd-detail h3 span { font: 500 11.5px var(--ia-font-mono); color: var(--ia-text-muted); }
+.sd-tags { display: flex; gap: 6px; flex-wrap: wrap; margin: 10px 0 14px; }
+.sd-tags span { font-size: 11px; font-weight: 600; padding: 3px 9px; border-radius: 99px; background: var(--ia-surface); border: 1px solid var(--ia-border); }
+.sd-kv { display: grid; grid-template-columns: 110px minmax(0, 1fr); gap: 8px 14px; font-size: 12.5px; margin: 0; }
+.sd-kv dt { color: var(--ia-text-muted); } .sd-kv dd { margin: 0; }
+.sd-ul { margin: 0; padding: 0; list-style: none; }
+.sd-ul li { display: flex; justify-content: space-between; gap: 10px; padding: 3px 0; border-bottom: 1px dashed var(--ia-border); }
+.sd-ul li span { color: var(--ia-text-muted); font-size: 12px; }
+.sd-act { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 16px; }
+
+/* rail */
+.sd-cal-h { display: flex; justify-content: space-between; align-items: baseline; font-size: 13px; margin-bottom: 10px; }
+.sd-cal-g { display: grid; grid-template-columns: repeat(7, 1fr); gap: 2px; text-align: center; font-size: 12px; font-variant-numeric: tabular-nums; }
+.sd-cal-g .w { font-size: 10.5px; color: var(--ia-text-dim); padding: 4px 0; text-transform: uppercase; }
+.sd-cal-g a { justify-self: center; width: 32px; height: 32px; line-height: 32px; border-radius: 50%; color: var(--ia-text); text-decoration: none;
+  background: color-mix(in srgb, var(--sd-t3) calc(var(--f) * 60%), transparent); }
+.sd-cal-g a:hover { box-shadow: inset 0 0 0 1px var(--ia-border-strong); }
+.sd-cal-g a.x { color: var(--ia-text-dim); background: none; }
+.sd-cal-g a.t { background: var(--ia-accent); color: var(--ia-accent-text); font-weight: 700; }
+.sd-cal-key { display: flex; gap: 12px; font-size: 11px; color: var(--ia-text-muted); margin-top: 8px; }
+.sd-cal-key i { display: inline-block; width: 10px; height: 10px; border-radius: 50%; margin-right: 5px; vertical-align: -1px; background: color-mix(in srgb, var(--sd-t3) calc(var(--f) * 60%), transparent); box-shadow: inset 0 0 0 1px var(--ia-border); }
+.sd-tl-h { display: flex; justify-content: space-between; align-items: baseline; margin: 24px 0 10px; padding-top: 18px; border-top: 1px solid var(--ia-border); font-size: 13px; }
+.sd-tl-h span { font-size: 12px; color: var(--ia-text-muted); }
+.sd-capbar { margin: 0 0 12px; height: 8px; }
+.sd-capbar span { background: var(--sd-t3); }
+.sd-tl-r { display: grid; grid-template-columns: 50px minmax(0, 1fr); gap: 10px; padding: 8px 0; font-size: 12.5px; text-decoration: none; color: inherit; }
+.sd-tl-r time { color: var(--ia-text-dim); font-variant-numeric: tabular-nums; font-size: 11.5px; padding-top: 1px; }
+.sd-tl-r > div { border-left: 2px solid var(--ia-border); padding-left: 12px; min-width: 0; }
+.sd-tl-r b { display: block; font-weight: 600; color: var(--ia-text); }
+.sd-tl-r b em { font-style: normal; font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: .06em; margin-right: 6px; padding: 1px 6px; border-radius: 4px; background: var(--ia-accent); color: var(--ia-accent-text); vertical-align: 1px; }
+.sd-tl-r span { color: var(--ia-text-muted); font-size: 11.5px; }
+.sd-tl-r:hover b { text-decoration: underline; }
+.sd-tl-r.done { opacity: .5; }
+.sd-tl-r.next > div, .sd-tl-r.active > div { border-left-color: var(--sd-ink); background: linear-gradient(90deg, color-mix(in srgb, var(--sd-t3) 40%, transparent), transparent); border-radius: 0 8px 8px 0; padding: 6px 12px; }
+body.ia-theme-c .sd-tl-r.next > div, body.ia-theme-c .sd-tl-r.active > div { border-left-color: var(--sd-t3); background: linear-gradient(90deg, color-mix(in srgb, var(--sd-t3) 14%, transparent), transparent); }
+
+.sd-empty { padding: 16px 0; font-size: 12.5px; color: var(--ia-text-muted); }
+.sd-empty-acts { display: flex; gap: 8px; margin-top: 10px; flex-wrap: wrap; }
+.sd-legend { margin-top: 30px; font-size: 11.5px; color: var(--ia-text-dim); }
+
+/* motion: blocks fade up in turn, once, when they reach the view (the same 85% line as the marketing sections) */
+html.sd-motion .sd-in { opacity: 0; transform: translateY(14px); transition: opacity .7s ease, transform .7s ease; transition-delay: var(--d, 0ms); }
+html.sd-motion .sd-in.is-in { opacity: 1; transform: none; }
+html.sd-motion .sd-tile:not(.is-in)::before { transform: scale(.15); opacity: 0; }
+html.sd-motion .sd-tile:not(.is-in) .sd-bars span { transform: scaleY(0); }
+html.sd-motion .sd-tile:not(.is-in) .sd-meter span, html.sd-motion .sd-tile:not(.is-in) .sd-stack span { transform: scaleX(0); }
+html.sd-motion .sd-tile:not(.is-in) .sd-spark .cur { stroke-dashoffset: 100; }
+html.sd-motion .sd-tile:not(.is-in) .sd-ring circle.v { stroke-dasharray: 0 100; }
+@media (prefers-reduced-motion: reduce) {
+  .sd-in, .sd-tile::before, .sd-tile *, .sd-row, .sd-head, .sd-hi { transition: none !important; }
+  .sd-blur { filter: none; opacity: 1; transform: none; }
+}
+
+/* tablet and phone */
+@media (max-width: 1023px) {
+  .sd-head { position: static; margin: 0 0 8px; padding: 6px 0 12px; grid-template-columns: minmax(0, 1fr); }
+  .sd-head-r { flex-wrap: wrap; }
+  .sd-hide-m { display: none; }
+  .sd-head-bar .ia-viewseg button { padding: 5px 8px; line-height: 0; }
+  .sd-head-bar .ia-viewseg .vs-lb { display: none; }
+  .sd-head-bar .ia-viewseg .vs-ic { display: inline-block; }
+  .sd-search { min-width: 0; flex: 1; }
+  .sd-search kbd { display: none; }
+  /* phone order: tiles, then today, then the queue */
+  .sd .dash-row { display: flex; flex-direction: column; align-items: stretch; gap: 30px; }
+  .sd .dash-row > .dash-col { display: contents; }
+  .sd-tiles { order: 1; margin-bottom: 0; } .sd-rail { order: 2; } .sd-queue { order: 3; }
+}
+@media (max-width: 640px) {
+  .sd-hi { font-size: 26px; }
+  .sd-tiles { grid-template-columns: minmax(0, 1fr); }
+  .sd-tiles.sd-n3 > .sd-tile:last-child { grid-column: auto; }
+  .sd-tile { min-height: 168px; }
+  .sd-row { grid-template-columns: 34px minmax(0, 1fr) auto; }
+  .sd-job, .sd-age { display: none; }
+  .sd-kv { grid-template-columns: 90px minmax(0, 1fr); }
+  .sd-seg { width: 100%; }
+  .sd-seg button { flex: 1; padding: 6px 4px; }
+}
diff --git a/public/js/tenant/dashboard-studio.js b/public/js/tenant/dashboard-studio.js
new file mode 100644
index 00000000..564d2a12
--- /dev/null
+++ b/public/js/tenant/dashboard-studio.js
@@ -0,0 +1,201 @@
+/* MARKER-DASH-STUDIO — the Studio dashboard's behaviour.
+ *
+ * Motion runs once on load: blocks fade up as they reach the view, tile
+ * colours spread and charts draw, numbers count up, queue rows below the fold
+ * come in soft and sharpen, and the header frosts once the page scrolls.
+ * Nothing moves for people whose device asks for less motion.
+ *
+ * The queue filters, the picked job's details, the multi-asset list, and a
+ * quiet refresh every few minutes while the tab is in view (no motion, keeps
+ * the picked job and filter).
+ */
+(function () {
+  'use strict';
+  var root = document.getElementById('sd');
+  if (!root) return;
+  var reduce = window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches;
+  if (!reduce) document.documentElement.classList.add('sd-motion');
+
+  function $(s, el) { return (el || document).querySelector(s); }
+  function $$(s, el) { return Array.prototype.slice.call((el || document).querySelectorAll(s)); }
+  function esc(s) { var d = document.createElement('div'); d.textContent = s == null ? '' : String(s); return d.innerHTML; }
+  function money(c) { return '$' + (c / 100).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }); }
+
+  // ---------------------------------------------------------------- motion
+  var pending = [];
+  function markBelow() {
+    if (reduce) return;
+    $$('.sd-row').forEach(function (r) {
+      if (r._seen) return;
+      if (r.getBoundingClientRect().top > innerHeight * 0.92) { r.classList.add('sd-blur'); pending.push(r); } else { r._seen = 1; }
+    });
+  }
+  function check() {
+    var line = innerHeight * 0.85;
+    $$('.sd-in:not(.is-in)').forEach(function (el) {
+      if (el.getBoundingClientRect().top < line) {
+        el.classList.add('is-in');
+        $$('.sd-tile', el).forEach(function (t) { t.classList.add('is-in'); });
+        if (el.classList.contains('sd-tile')) count(el);
+      }
+    });
+    pending = pending.filter(function (r) {
+      if (r.getBoundingClientRect().top < innerHeight * 0.92) { r.classList.remove('sd-blur'); r._seen = 1; return false; }
+      return true;
+    });
+    var head = $('#sdHead');
+    if (head) head.classList.toggle('frost', window.scrollY > 24 && innerWidth > 1023);
+  }
+  function count(tile) {
+    $$('[data-count]', tile).forEach(function (el) {
+      if (el._counted) return; el._counted = 1;
+      var to = +el.dataset.count || 0, pre = el.dataset.pre || '', t0 = null, dur = reduce ? 0 : 900;
+      function step(ts) {
+        if (!t0) t0 = ts;
+        var p = dur ? Math.min(1, (ts - t0) / dur) : 1;
+        el.textContent = pre + Math.round(to * (1 - Math.pow(1 - p, 3))).toLocaleString('en-US');
+        if (p < 1) requestAnimationFrame(step);
+      }
+      if (dur) { el.textContent = pre + '0'; requestAnimationFrame(step); }
+    });
+  }
+  // tiles are drawn inside .sd-tiles; each tile appears on its own delay
+  $$('.sd-tile').forEach(function (t) { t.classList.add('sd-in'); });
+  var raf = 0;
+  addEventListener('scroll', function () { if (!raf) raf = requestAnimationFrame(function () { raf = 0; check(); hidePop(); }); }, { passive: true });
+  addEventListener('resize', check);
+
+  // ------------------------------------------------------------ queue + detail
+  var data = [], filter = 'all', sel = 0;
+  function readData() {
+    var el = $('#sdQueue');
+    try { data = el ? JSON.parse(el.textContent) : []; } catch (e) { data = []; }
+  }
+  function detail(i) {
+    var box = $('#sdDetail'), r = data[i];
+    if (!box) return;
+    if (!r) { box.hidden = true; return; }
+    box.hidden = false;
+    box.classList.add('swap');
+    setTimeout(function () {
+      var assetP = box.dataset.assetP || 'items';
+      var h = '<h3>' + esc(r.who) + ' · ' + esc(r.title) + '<span>' + esc(r.number) + '</span></h3>';
+      h += '<div class="sd-tags"><span>' + esc(r.late ? 'Late' : r.groupLabel) + '</span><span>In the shop ' + esc(r.age) + '</span>' +
+        (r.due > 0 ? '<span>' + money(r.due) + ' due</span>' : (r.total > 0 ? '<span>Paid</span>' : '')) + '</div><dl class="sd-kv">';
+      if (r.assets && r.assets.length > 1) {
+        h += '<dt>' + esc(assetP.charAt(0).toUpperCase() + assetP.slice(1)) + '</dt><dd><ul class="sd-ul">' + r.assets.map(function (a) {
+          return '<li>' + esc(a.name) + '<span>' + esc(a.services) + (a.when ? ' · ' + esc(a.when) : '') + '</span></li>';
+        }).join('') + '</ul></dd>';
+      }
+      if (r.notes) h += '<dt>Notes</dt><dd>' + esc(r.notes) + '</dd>';
+      if (r.total > 0) h += '<dt>Total</dt><dd>' + money(r.total) + (r.due > 0 && r.due < r.total ? ' · ' + money(r.due) + ' still due' : '') + '</dd>';
+      if (r.phone) h += '<dt>Contact</dt><dd>' + esc(r.phone) + '</dd>';
+      h += '</dl><div class="sd-act"><a class="ia-btn ia-btn--sm ia-btn--primary" href="' + esc(r.url) + '">Open work order</a>';
+      if (r.phone) h += '<a class="ia-btn ia-btn--sm" href="sms:' + esc(String(r.phone).replace(/[^\d+]/g, '')) + '">Text ' + esc(r.who.split(' ')[0]) + '</a>';
+      if (r.customerUrl) h += '<a class="ia-btn ia-btn--sm" href="' + esc(r.customerUrl) + '">Customer</a>';
+      if (r.group === 'ready' && box.dataset.canRegister === '1') h += '<a class="ia-btn ia-btn--sm" href="' + esc(box.dataset.registerUrl) + '">Ring up</a>';
+      h += '</div>';
+      box.innerHTML = h;
+      box.classList.remove('swap');
+    }, 110);
+  }
+  function applyFilter() {
+    var list = $('#sdList');
+    if (!list) return;
+    var shown = 0, firstShown = null;
+    $$('.sd-row', list).forEach(function (row) {
+      var on = filter === 'all' || row.dataset.group === filter;
+      row.hidden = !on;
+      if (on) { shown++; if (firstShown === null) firstShown = +row.dataset.i; }
+    });
+    var none = $('.sd-none', list); if (none) none.hidden = shown > 0;
+    var selRow = $('.sd-row[data-i="' + sel + '"]', list);
+    if (!selRow || selRow.hidden) { if (firstShown !== null) pick(firstShown); else detail(-1); }
+  }
+  function pick(i) {
+    sel = i;
+    $$('.sd-row').forEach(function (r) { r.classList.toggle('sel', +r.dataset.i === i); });
+    detail(i);
+  }
+  root.addEventListener('click', function (e) {
+    var m = e.target.closest('.sd-multi');
+    if (m) { e.preventDefault(); e.stopPropagation(); popFor === m ? hidePop() : showPop(m); return; }
+    var b = e.target.closest('.sd-seg button');
+    if (b) {
+      filter = b.dataset.f;
+      $$('.sd-seg button').forEach(function (x) { x.classList.toggle('on', x === b); });
+      applyFilter();
+      return;
+    }
+    var row = e.target.closest('.sd-row');
+    if (row) pick(+row.dataset.i);
+  });
+  root.addEventListener('keydown', function (e) {
+    var row = e.target.closest && e.target.closest('.sd-row');
+    if (row && (e.key === 'Enter' || e.key === ' ')) { e.preventDefault(); pick(+row.dataset.i); }
+  });
+
+  // ------------------------------------------------------- multi-asset list
+  var pop = document.getElementById('sdPop'), popFor = null;
+  function showPop(btn) {
+    var list;
+    try { list = JSON.parse(btn.dataset.assets || '[]'); } catch (e) { list = []; }
+    if (!pop || !list.length) return;
+    pop.innerHTML = '<h4>' + list.length + ' on this booking</h4>' + list.map(function (a) {
+      return '<div><b>' + esc(a.name) + (a.when ? '<span>' + esc(a.when) + '</span>' : '') + '</b><small>' + esc(a.services) + '</small></div>';
+    }).join('');
+    pop.hidden = false;
+    var r = btn.getBoundingClientRect(), w = pop.offsetWidth, hgt = pop.offsetHeight;
+    pop.style.left = Math.max(8, Math.min(r.left, innerWidth - w - 8)) + 'px';
+    pop.style.top = (r.bottom + 8 + hgt > innerHeight ? Math.max(8, r.top - hgt - 8) : r.bottom + 8) + 'px';
+    popFor = btn;
+  }
+  function hidePop() { if (pop) pop.hidden = true; popFor = null; }
+  root.addEventListener('mouseover', function (e) { var m = e.target.closest('.sd-multi'); if (m && matchMedia('(hover: hover)').matches) showPop(m); });
+  root.addEventListener('mouseout', function (e) { if (e.target.closest('.sd-multi') && matchMedia('(hover: hover)').matches) hidePop(); });
+  root.addEventListener('focusin', function (e) { var m = e.target.closest('.sd-multi'); if (m) showPop(m); });
+  root.addEventListener('focusout', function (e) { if (e.target.closest('.sd-multi')) hidePop(); });
+  document.addEventListener('click', function (e) { if (popFor && !e.target.closest('.sd-multi')) hidePop(); });
+  document.addEventListener('keydown', function (e) { if (e.key === 'Escape') hidePop(); });
+
+  // ---------------------------------------------------------- quiet refresh
+  // Every 3 minutes while the tab is in view, fetch the page again and swap
+  // the live parts in place. No motion; the filter and picked job stay.
+  var REFRESH = 180000, last = Date.now(), busy = false;
+  function refresh() {
+    if (busy || document.hidden || Date.now() - last < REFRESH) return;
+    busy = true;
+    fetch(location.href, { credentials: 'same-origin', headers: { 'X-Requested-With': 'XMLHttpRequest' } })
+      .then(function (r) { if (!r.ok) throw r.status; return r.text(); })
+      .then(function (html) {
+        var doc = new DOMParser().parseFromString(html, 'text/html');
+        $$('[data-sd-live]').forEach(function (el) {
+          var fresh = doc.querySelector('[data-sd-live="' + el.dataset.sdLive + '"]');
+          if (!fresh) return;
+          $$('.sd-in', fresh).concat(fresh.classList.contains('sd-in') ? [fresh] : []).forEach(function (x) { x.classList.add('is-in'); });
+          $$('.sd-tile', fresh).forEach(function (x) { x.classList.add('sd-in', 'is-in'); });
+          $$('[data-count]', fresh).forEach(function (x) { x._counted = 1; });
+          el.replaceWith(fresh);
+        });
+        $$('.sd-row').forEach(function (r) { r._seen = 1; });
+        readData();
+        var keep = filter;
+        $$('.sd-seg button').forEach(function (x) { x.classList.toggle('on', x.dataset.f === keep); });
+        if (!data[sel]) sel = 0;
+        applyFilter();
+        $$('.sd-row').forEach(function (r) { r.classList.toggle('sel', +r.dataset.i === sel); });
+        detail(sel);
+      })
+      .catch(function () { /* stay on what's shown; the next tick tries again */ })
+      .then(function () { busy = false; last = Date.now(); });
+  }
+  setInterval(refresh, 30000);
+  document.addEventListener('visibilitychange', function () { if (!document.hidden) refresh(); });
+
+  // ------------------------------------------------------------------ start
+  readData();
+  if (data.length) pick(0);
+  markBelow();
+  requestAnimationFrame(function () { setTimeout(check, 40); });
+  if (reduce) $$('.sd-tile').forEach(count);
+})();
