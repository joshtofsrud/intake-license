+.sd-ny-clear i { font-style: normal; width: 22px; height: 22px; border-radius: 50%; display: grid; place-items: center; font-size: 11px; background: color-mix(in srgb, var(--sd-t3) 55%, var(--ia-surface)); color: var(--sd-ink); }
