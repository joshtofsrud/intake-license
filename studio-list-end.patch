From 2e9291994ebd7159d7a4e7e572bdda57f7c6d0ac Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sat, 7 Nov 2026 08:22:43 -0800
Subject: [PATCH] Studio and rental desk lists: rows further down no longer
 stay blank while the list scrolls; an animated end-of-list marker for each
 filter

---
 public/css/tenant/dashboard-studio.css        |  8 ++++++
 public/js/tenant/dashboard-studio.js          | 26 +++++++++++++++++--
 .../dashboard/blocks/studio-queue.blade.php   |  1 +
 resources/views/tenant/rentals/desk.blade.php |  1 +
 4 files changed, 34 insertions(+), 2 deletions(-)

diff --git a/public/css/tenant/dashboard-studio.css b/public/css/tenant/dashboard-studio.css
index db3c56b9..ee8fe0c1 100644
--- a/public/css/tenant/dashboard-studio.css
+++ b/public/css/tenant/dashboard-studio.css
@@ -113,6 +113,14 @@ body.ia-theme-c .sd-st { background: color-mix(in srgb, var(--c) 16%, transparen
 .sd-more { display: inline-block; margin-top: 10px; }
 @media (min-width: 1024px) { .sd-list { max-height: 600px; overflow-y: auto; overscroll-behavior: contain; scrollbar-width: thin; } }
 .sd-none { padding: 18px 4px; font-size: 12.5px; color: var(--ia-text-muted); }
+/* the full stop at the bottom of the list: two rules draw in from the middle, the words rise between them */
+.sd-end { display: flex; align-items: center; gap: 12px; padding: 22px 6px 10px; font-size: 11.5px; font-weight: 600; letter-spacing: .04em; color: var(--ia-text-dim); }
+.sd-end i { flex: 1; height: 1px; background: var(--ia-border-strong); transform: scaleX(0); transition: transform .7s cubic-bezier(.2, .7, .1, 1); }
+.sd-end i:first-child { transform-origin: right; } .sd-end i:last-child { transform-origin: left; }
+.sd-end span { white-space: nowrap; opacity: 0; transform: translateY(6px); transition: opacity .5s ease .25s, transform .5s ease .25s; }
+.sd-end.in i { transform: scaleX(1); }
+.sd-end.in span { opacity: 1; transform: none; }
+@media (prefers-reduced-motion: reduce) { .sd-end i, .sd-end span { transition: none; transform: none; opacity: 1; } }
 /* rows below the fold come in soft and sharpen */
 .sd-blur { filter: blur(6px); opacity: 0; transform: translateY(10px); }
 
diff --git a/public/js/tenant/dashboard-studio.js b/public/js/tenant/dashboard-studio.js
index bf9a4990..d9646a21 100644
--- a/public/js/tenant/dashboard-studio.js
+++ b/public/js/tenant/dashboard-studio.js
@@ -39,10 +39,13 @@
         if (el.classList.contains('sd-tile')) count(el);
       }
     });
+    var lst = $('#sdList'), lb = lst ? lst.getBoundingClientRect().bottom : Infinity;
     pending = pending.filter(function (r) {
-      if (r.getBoundingClientRect().top < innerHeight * 0.92) { r.classList.remove('sd-blur'); r._seen = 1; return false; }
+      // in view of the window AND of the list (the list scrolls on its own on desktop)
+      if (r.getBoundingClientRect().top < Math.min(innerHeight * 0.92, lb - 8)) { r.classList.remove('sd-blur'); r._seen = 1; return false; }
       return true;
     });
+    endCap();
     var head = $('#sdHead');
     if (head) head.classList.toggle('frost', window.scrollY > 24 && innerWidth > 1023);
   }
@@ -120,9 +123,26 @@
       if (on) { shown++; if (firstShown === null) firstShown = +row.dataset.i; }
     });
     var none = $('.sd-none', list); if (none) none.hidden = shown > 0;
+    var end = $('.sd-end', list);
+    if (end) {
+      var b = $('.sd-seg button.on');
+      var name = b ? b.textContent.replace(/\s*\d+\s*$/, '') : 'All';
+      end.hidden = shown === 0;
+      end.classList.remove('in');
+      var word = end.dataset.word || 'jobs';
+      end.querySelector('span').textContent = (filter === 'all' ? 'End of the list' : 'End of ' + name) + ' · ' + shown + ' ' + (shown === 1 ? word.replace(/s$/, '') : word);
+      requestAnimationFrame(endCap);
+    }
     var selRow = $('.sd-row[data-i="' + sel + '"]', list);
     if (!selRow || selRow.hidden) { if (firstShown !== null) pick(firstShown); else detail(-1); }
   }
+  // "End of …" draws itself in once it comes into view, putting a full stop on the list
+  function endCap() {
+    var end = $('.sd-end'), lst = $('#sdList');
+    if (!end || end.hidden || end.classList.contains('in')) return;
+    var r = end.getBoundingClientRect(), lb = lst ? lst.getBoundingClientRect().bottom : innerHeight;
+    if (r.top < Math.min(innerHeight, lb) - 4 && r.bottom > 0) end.classList.add('in');
+  }
   function pick(i) {
     sel = i;
     $$('.sd-row').forEach(function (r) { r.classList.toggle('sel', +r.dataset.i === i); });
@@ -205,7 +225,9 @@
 
   // ------------------------------------------------------------------ start
   readData();
-  if (data.length) pick(0);
+  if (data.length) { pick(0); applyFilter(); }
+  var listEl = $('#sdList');
+  if (listEl) listEl.addEventListener('scroll', function () { if (!raf) raf = requestAnimationFrame(function () { raf = 0; check(); hidePop(); }); }, { passive: true });
   markBelow();
   requestAnimationFrame(function () { setTimeout(check, 40); });
   if (reduce) $$('.sd-tile').forEach(count);
diff --git a/resources/views/tenant/dashboard/blocks/studio-queue.blade.php b/resources/views/tenant/dashboard/blocks/studio-queue.blade.php
index a43db122..1c14d507 100644
--- a/resources/views/tenant/dashboard/blocks/studio-queue.blade.php
+++ b/resources/views/tenant/dashboard/blocks/studio-queue.blade.php
@@ -35,6 +35,7 @@
         </div>
       @endforeach
       <div class="sd-none" hidden>None here right now.</div>
+      <div class="sd-end" data-word="jobs"><i></i><span>End of the list</span><i></i></div>
     </div>
     @if ($q['more'])
       <a class="sd-link sd-more" href="{{ route('tenant.appointments.index') }}">{{ $q['more'] }} more in Work orders →</a>
diff --git a/resources/views/tenant/rentals/desk.blade.php b/resources/views/tenant/rentals/desk.blade.php
index c171de34..d754cae7 100644
--- a/resources/views/tenant/rentals/desk.blade.php
+++ b/resources/views/tenant/rentals/desk.blade.php
@@ -81,6 +81,7 @@
               </div>
             @endforeach
             <div class="sd-none" hidden>None here right now.</div>
+      <div class="sd-end" data-word="bookings"><i></i><span>End of the list</span><i></i></div>
           </div>
           @if ($bk['more'])
             <a class="sd-link sd-more" href="{{ route('tenant.rentals.bookings.index') }}">{{ $bk['more'] }} more in Bookings →</a>
-- 
