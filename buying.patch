@@ -0,0 +1,105 @@
+/* MARKER-BUYING: Buying page. Uses report-builder.css (rb-*) and the app's own classes; these are the extras. */
+.ivr-window{display:inline-flex;background:var(--ia-surface);border:1px solid var(--ia-border);border-radius:9px;padding:3px}
+.ivr-window a{padding:5px 12px;font-size:12px;font-weight:600;border-radius:6px;color:var(--ia-text-dim);text-decoration:none}
+.ivr-window a.on{background:var(--ia-surface-2);color:var(--ia-text)}
+.by-tabs{display:flex;gap:4px;border-bottom:1px solid var(--ia-border);margin-bottom:22px}
+.mk-tbl tr.click{cursor:pointer}
+.by-more{display:flex;justify-content:center;padding:14px 0}
+.by-toast-a{color:var(--ia-accent);margin-left:10px;font-weight:600;text-decoration:none}
+.by-ro{color:var(--ia-text-muted);font-size:12px}
+body{--mk-red:var(--rb-bad);--mk-amber:var(--rb-warn);--mk-green:var(--rb-good);--mk-blue:var(--rb-info);--mk-grey:var(--ia-text-dim)}
+.mk-tab{padding:9px 14px;font-size:13px;color:var(--ia-text-dim);border-bottom:2px solid transparent;margin-bottom:-1px;white-space:nowrap;text-decoration:none}
+.mk-tab.on{color:var(--ia-text);border-bottom-color:var(--ia-accent);font-weight:500}
+.mk-tabn{margin-left:6px;font-size:11px;background:var(--ia-surface-2);border-radius:99px;padding:1px 7px;color:var(--ia-text-muted)}
+.mk-count{margin-left:6px;font-size:11px;background:var(--ia-accent);color:var(--ia-accent-text);border-radius:99px;padding:0 7px;font-weight:700}
+.mk-pane{display:none}.mk-pane.on{display:block}
+.mk-legend{font-size:12.5px;color:var(--ia-text-muted);line-height:1.55;border-left:2px solid var(--ia-border-strong);padding:2px 0 2px 12px;margin:0 0 22px;max-width:880px}
+.mk-legend b{color:var(--ia-text);font-weight:600}
+.mk-search{max-width:200px;padding:6px 10px;font-size:12px;border-radius:8px}
+/* status bar */
+.mk-stack{display:flex;height:34px;gap:3px;margin-bottom:8px}
+.mk-seg{border:0;border-radius:6px;display:flex;align-items:center;padding:0 10px;font-size:12px;font-weight:600;min-width:34px;cursor:pointer;transition:filter .15s,opacity .15s;color:#fff}
+.mk-seg:hover{filter:brightness(1.12)}
+.mk-seg.dim{opacity:.35}
+.mk-seg.out{background:#A32D2D}.mk-seg.reorder{background:#B7791F}.mk-seg.soon{background:#2F6FB0}.mk-seg.ok{background:#3B6D11}.mk-seg.over{background:#6b6b6b}
+.mk-stack-keys{display:flex;gap:18px;flex-wrap:wrap;font-size:12px;color:var(--ia-text-dim);margin-bottom:22px}
+.mk-stack-keys span b{color:var(--ia-text);font-weight:600;font-variant-numeric:tabular-nums;margin-right:4px}
+.mk-stack-keys i{display:inline-block;width:8px;height:8px;border-radius:2px;margin-right:6px}
+/* table bits */
+.mk-tbl .ia-table td{vertical-align:middle}
+.mk-item{font-weight:500}.mk-item small{display:block;font-weight:400;color:var(--ia-text-muted);font-size:11px;font-family:var(--ia-font-mono)}
+.mk-sold{display:flex;align-items:center;gap:10px;font-variant-numeric:tabular-nums}
+.mk-sold svg{display:block}
+.mk-dist b{font-weight:600;font-variant-numeric:tabular-nums}.mk-dist small{display:block;color:var(--ia-text-muted);font-size:11px}
+.mk-dist .low{color:var(--rb-warn)}
+.mk-arr small{display:block;font-size:11px;color:var(--ia-text-muted)}
+.mk-arr .gap{color:var(--rb-bad);font-weight:600}
+.dash{color:var(--ia-text-dim)}
+.mk-empty{padding:42px 0;text-align:center;border-top:1px solid var(--ia-border)}
+.mk-empty .t{font-weight:500}.mk-empty .s{color:var(--ia-text-muted);font-size:12.5px;margin:4px 0 14px}
+.rb-pill.bad{background:var(--rb-bad-bg);color:var(--rb-bad)}.rb-pill.warn{background:var(--rb-warn-bg);color:var(--rb-warn)}
+.rb-pill.info{background:var(--rb-info-bg);color:var(--rb-info)}.rb-pill.mute{background:var(--ia-surface-2);color:var(--ia-text-muted)}
+.mk-savebar{display:flex;align-items:center;gap:12px;margin-top:16px}
+.mk-goal{width:110px;text-align:right;padding:4px 8px;font-size:12.5px;border-radius:6px}
+.mk-meter{height:6px;border-radius:99px;background:var(--ia-surface-2);overflow:hidden;min-width:120px}
+.mk-meter i{display:block;height:100%;border-radius:99px}
+/* drawer + modal */
+.mk-scrim{position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:80}
+.mk-drawer{position:fixed;top:0;right:0;bottom:0;width:440px;max-width:100vw;z-index:90;background:var(--ia-bg);border-left:1px solid var(--ia-border-strong);display:flex;flex-direction:column}
+.mk-dh{display:flex;justify-content:space-between;gap:12px;padding:18px 20px;border-bottom:1px solid var(--ia-border)}
+.mk-dt{font-size:16px;font-weight:600}.mk-ds{font-size:12px;color:var(--ia-text-muted);margin-top:2px}
+.mk-db{padding:18px 20px;overflow-y:auto;flex:1}
+.mk-df{display:flex;gap:8px;align-items:center;padding:14px 20px;border-top:1px solid var(--ia-border)}.mk-df .sp{flex:1}
+.mk-note{font-size:13px;line-height:1.5;margin-top:12px;color:var(--ia-text)}
+.mk-kv{display:grid;grid-template-columns:1fr 1fr;border-top:1px solid var(--ia-border);margin-top:14px}
+.mk-kv div{padding:10px 0;border-bottom:1px solid var(--ia-border);font-size:12.5px}
+.mk-kv div:nth-child(odd){padding-right:12px}.mk-kv div:nth-child(even){padding-left:12px;border-left:1px solid var(--ia-border)}
+.mk-kv small{display:block;font-size:10.5px;letter-spacing:.07em;text-transform:uppercase;color:var(--ia-text-dim);margin-bottom:3px}
+.mk-kv b{font-size:15px;font-weight:500;font-variant-numeric:tabular-nums}
+.mk-form{display:grid;gap:12px}.mk-form label{display:flex;justify-content:space-between;align-items:center;font-size:12.5px;gap:12px}
+.mk-step{display:inline-flex;align-items:center;gap:6px}.mk-step button{width:28px;height:28px;border-radius:7px;border:1px solid var(--ia-border);background:var(--ia-surface);color:var(--ia-text);font-size:15px}
+.mk-step input{width:70px;text-align:center;padding:5px 6px}
+.mk-modal{position:fixed;inset:0;z-index:100;background:rgba(0,0,0,.55);display:flex;align-items:center;justify-content:center;padding:16px}
+.mk-modal[hidden],.mk-drawer[hidden],.mk-scrim[hidden],.mk-lock[hidden],.mk-empty[hidden]{display:none}
+.mk-dialog{background:var(--ia-bg);border:1px solid var(--ia-border-strong);border-radius:14px;width:560px;max-width:100%;max-height:86vh;display:flex;flex-direction:column;overflow:hidden}
+.mk-dialog--sm{width:400px}.mk-cf-p{font-size:13px;color:var(--ia-text-muted);margin-top:8px;line-height:1.5}
+.mk-ol-g{margin-bottom:18px}.mk-ol-g h3{font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:var(--ia-text-dim);font-weight:500;margin-bottom:4px}
+.mk-ol-r{display:flex;align-items:center;gap:10px;padding:9px 0;border-bottom:1px solid var(--ia-border);font-size:13px}
+.mk-ol-r .n{flex:1}.mk-ol-r .n small{display:block;color:var(--ia-text-muted);font-size:11px}
+.mk-ol-r .q{font-variant-numeric:tabular-nums;color:var(--ia-text-muted);white-space:nowrap}
+/* lock */
+.mk-lock{display:flex;justify-content:flex-start;padding:10px 0 60px}
+.mk-lock-panel{max-width:560px;border-top:1px solid var(--ia-border-strong);padding-top:22px}
+.mk-lock-eyebrow{font-size:11px;letter-spacing:.09em;text-transform:uppercase;color:var(--ia-text-dim);margin-bottom:6px}
+.mk-lock h2{font-size:26px;font-weight:600;letter-spacing:-.01em;margin-bottom:10px}
+.mk-lock p{font-size:14px;color:var(--ia-text-muted);line-height:1.6}
