+.mk-lock li{padding:9px 0;border-bottom:1px solid var(--ia-border);font-size:13.5px}
+.mk-lock-actions{display:flex;gap:10px;flex-wrap:wrap}
+@media(max-width:900px){.mk-drawer{width:100vw}}
+
