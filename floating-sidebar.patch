diff --git a/database/migrations/2026_11_07_000200_floating_sidebar.php b/database/migrations/2026_11_07_000200_floating_sidebar.php
new file mode 100644
index 00000000..7d61788b
--- /dev/null
+++ b/database/migrations/2026_11_07_000200_floating_sidebar.php
@@ -0,0 +1,30 @@
+<?php
+
+use Illuminate\Database\Migrations\Migration;
+use Illuminate\Database\Schema\Blueprint;
+use Illuminate\Support\Facades\Schema;
+
+/**
+ * MARKER-FLOAT-SIDEBAR: each person's sidebar style. Null or 'locked' is the
+ * sidebar as it has always been; 'float' insets it as a rounded panel.
+ */
+return new class extends Migration
+{
+    public function up(): void
+    {
+        if (! Schema::hasColumn('tenant_users', 'admin_sidebar')) {
+            Schema::table('tenant_users', function (Blueprint $t) {
+                $t->string('admin_sidebar', 8)->nullable()->after('admin_theme');
+            });
+        }
+    }
+
+    public function down(): void
+    {
+        if (Schema::hasColumn('tenant_users', 'admin_sidebar')) {
+            Schema::table('tenant_users', function (Blueprint $t) {
+                $t->dropColumn('admin_sidebar');
+            });
+        }
+    }
+};
diff --git a/public/css/tenant/base.css b/public/css/tenant/base.css
index 68a16455..bf8d12b3 100644
--- a/public/css/tenant/base.css
+++ b/public/css/tenant/base.css
@@ -1541,3 +1541,23 @@ html.ia-sb-collapsed .ia-sidebar-logo {
   transition: color var(--ia-t);
 }
 .ia-back-link:hover { color: var(--ia-text); text-decoration: underline; }
+
+
+/* ==========================================================================
+   MARKER-FLOAT-SIDEBAR — floating sidebar (a per-person choice, in the
+   account menu). The same sidebar, inset from the window as a rounded panel.
+   Desktop only: phones keep their bottom bar.
+   ========================================================================== */
+@media (min-width: 1024px) {
+  html.ia-float .ia-shell { grid-template-columns: 244px 1fr; }
+  html.ia-float.ia-sb-collapsed .ia-shell { grid-template-columns: 84px 1fr; }
+  html.ia-float .ia-sidebar {
+    margin: 12px 0 12px 12px; top: 12px; height: calc(100vh - 24px);
+    border-radius: 20px; border-right: 0 !important;
+    box-shadow: 0 10px 30px rgba(0, 0, 0, .18), 0 0 0 1px var(--ia-side-border, rgba(255, 255, 255, .07));
+  }
+  html.ia-float body.ia-theme-c .ia-sidebar { background: #151515; box-shadow: 0 10px 40px rgba(0, 0, 0, .5), 0 0 0 1px rgba(255, 255, 255, .06); }
+  /* the active row's edge marker sits on the panel's rounded edge; the highlight is enough */
+  html.ia-float .ia-nav-item.active::before { display: none; }
+  html.ia-float.ia-sb-collapsed .ia-sb-user-menu { left: 74px; }
+}
