diff --git a/app/Providers/AppServiceProvider.php b/app/Providers/AppServiceProvider.php
index 62a5c593..752a005a 100644
--- a/app/Providers/AppServiceProvider.php
+++ b/app/Providers/AppServiceProvider.php
@@ -36,6 +36,16 @@ class AppServiceProvider extends ServiceProvider
 
     public function boot(): void
     {
+        // MARKER-CF-IP: requests arrive through Cloudflare, so without this every
+        // request()->ip() was a Cloudflare edge address — login throttles were
+        // shared across shops, and waivers, consent and debug logs recorded the
+        // wrong address. Only X-Forwarded-For is trusted, and only from
+        // Cloudflare's ranges: Host and scheme are left as they were.
+        if (config('cloudflare.trust') && config('cloudflare.ips')) {
+            \Illuminate\Http\Middleware\TrustProxies::at(config('cloudflare.ips'));
+            \Illuminate\Http\Middleware\TrustProxies::withHeaders(\Illuminate\Http\Request::HEADER_X_FORWARDED_FOR);
+        }
+
         // MARKER-SEC-AUDIT: workers are long-lived; each job reads add-on access fresh
         \Illuminate\Support\Facades\Queue::before(fn () => \App\Services\FeatureAccessService::flushRequestCache());
         // MARKER-ADMIN-TZ: same for the master-admin time zone, so a changed setting reaches workers
diff --git a/app/Services/DebugLogService.php b/app/Services/DebugLogService.php
index 2d0683c2..b8d1552a 100644
--- a/app/Services/DebugLogService.php
+++ b/app/Services/DebugLogService.php
@@ -134,10 +134,47 @@ class DebugLogService
                     'file'      => $e->getPrevious()->getFile(),
                     'line'      => $e->getPrevious()->getLine(),
                 ] : null,
-            ], $extra),
+            ], $this->livewireContext(), $extra),
         ]);
     }
 
+    /**
+     * MARKER-CF-IP: a Livewire update always posts to /livewire/update, so the
+     * logged path says nothing about where it came from. Record the page it was
+     * sent from and the component names (names only — never the payload), so a
+     * burst of these can be traced to one screen or told apart from a bot.
+     */
+    protected function livewireContext(): array
+    {
+        try {
+            if (! app()->bound('request')) return [];
+            $r = request();
+            if (! str_contains('/' . ltrim($r->path(), '/'), 'livewire') || ! $r->isMethod('post')) return [];
+
+            $page = null;
+            if ($ref = (string) $r->headers->get('referer', '')) {
+                $parts = parse_url($ref) ?: [];
+                $page = (isset($parts['host']) ? ($parts['scheme'] ?? 'https') . '://' . $parts['host'] : '')
+                      . self::maskPath($parts['path'] ?? '/');
+            }
+
+            $names = [];
+            foreach ((array) $r->input('components', []) as $c) {
+                $snap = is_array($c) ? json_decode((string) ($c['snapshot'] ?? ''), true) : null;
+                $name = is_array($snap) ? ($snap['memo']['name'] ?? null) : null;
+                $names[] = is_string($name) ? Str::limit($name, 120, '') : '(unreadable)';
+            }
+
+            // flat strings: the View page shows context as key/value text
+            return [
+                'livewire_page'       => $page ?: '(no referer, so not sent from a page in a browser)',
+                'livewire_components' => $names ? implode(', ', array_slice(array_values(array_unique($names)), 0, 10)) : '(none sent)',
+            ];
+        } catch (Throwable $ignored) {
+            return [];
+        }
+    }
+
     /**
      * Log a sent email. Wire this from the MessageSent Mail event listener.
      */
diff --git a/config/cloudflare.php b/config/cloudflare.php
new file mode 100644
index 00000000..f823e4de
--- /dev/null
+++ b/config/cloudflare.php
@@ -0,0 +1,35 @@
+<?php
+
+return [
+
+    /*
+    |--------------------------------------------------------------------------
+    | Cloudflare edge address ranges
+    |--------------------------------------------------------------------------
+    | Traffic reaches the server through Cloudflare, so the address the server
+    | sees is Cloudflare's, not the visitor's. Requests that come FROM one of
+    | these ranges are trusted to say who the visitor is (X-Forwarded-For).
+    | Anything else is taken at face value, so a request sent straight to the
+    | server can't fake an address.
+    |
+    | Published at https://www.cloudflare.com/ips/ — they change rarely. Add a
+    | new range without a deploy by putting it in CLOUDFLARE_EXTRA_IPS
+    | (comma separated). If a range is missing, those visitors simply show
+    | as a Cloudflare address, which is how it worked before.
+    |
+    | Set CLOUDFLARE_TRUST=false to switch this off.
+    */
+    'trust' => env('CLOUDFLARE_TRUST', true),
+
+    'ips' => array_values(array_filter(array_merge([
+        // IPv4
+        '173.245.48.0/20', '103.21.244.0/22', '103.22.200.0/22', '103.31.4.0/22',
+        '141.101.64.0/18', '108.162.192.0/18', '190.93.240.0/20', '188.114.96.0/20',
+        '197.234.240.0/22', '198.41.128.0/17', '162.158.0.0/15', '104.16.0.0/13',
+        '104.24.0.0/14', '172.64.0.0/13', '131.0.72.0/22',
+        // IPv6
+        '2400:cb00::/32', '2606:4700::/32', '2803:f800::/32', '2405:b500::/32',
+        '2405:8100::/32', '2a06:98c0::/29', '2c0f:f248::/32',
+    ], array_map('trim', explode(',', (string) env('CLOUDFLARE_EXTRA_IPS', '')))))),
+
+];
