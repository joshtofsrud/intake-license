diff --git a/app/Filament/Pages/DashboardPreview.php b/app/Filament/Pages/DashboardPreview.php
new file mode 100644
index 00000000..adbc93b2
--- /dev/null
+++ b/app/Filament/Pages/DashboardPreview.php
@@ -0,0 +1,108 @@
+<?php
+
+namespace App\Filament\Pages;
+
+use App\Models\DashboardTemplate;
+use App\Models\Tenant;
+use App\Models\Tenant\TenantRole;
+use App\Support\Dashboard\Audience;
+use App\Support\Dashboard\BlockRegistry;
+use App\Support\Dashboard\TemplateStore;
+use Filament\Pages\Page;
+use Livewire\Attributes\Url;
+
+/**
+ * MARKER-DASH-PREVIEW: full-screen preview of a template or one block, drawn
+ * from a real shop's data as one of its roles would see it. Opened from the
+ * Templates and Blocks tabs, the template editor and the block builder.
+ * Read-only.
+ */
+class DashboardPreview extends Page
+{
+    use \App\Support\GatedByAdminArea;
+    protected static string $adminArea = 'tenants';
+
+    protected static bool $shouldRegisterNavigation = false;
+    protected static ?string $slug = 'dashboard-preview';
+    protected static ?string $title = 'Preview';
+    protected static string $view = 'filament.pages.dashboard-preview';
+
+    #[Url] public string $t = '';
+    #[Url] public string $b = '';
+    #[Url] public string $v = 'live';
+    #[Url] public string $shop = '';
+    #[Url] public string $role = 'owner';
+    #[Url] public string $device = 'desktop';
+    #[Url] public int $w = 12;
+
+    public function mount(): void
+    {
+        if ($this->t === '' && $this->b === '') {
+            $this->redirect(Dashboards::getUrl());
+            return;
+        }
+        if ($this->shop === '' || ! Tenant::whereKey($this->shop)->exists()) {
+            $this->shop = (string) $this->defaultShop();
+        }
+        if ($this->t !== '') {
+            $tpl = DashboardTemplate::where('key', $this->t)->first();
+            if (! $tpl) { $this->redirect(Dashboards::getUrl()); return; }
+            if (! $tpl->live_version_id) $this->v = 'draft';
+        }
+    }
+
+    /** Ground Control when it's here, else the shop with the most bookings, so the figures aren't empty. */
+    private function defaultShop(): ?string
+    {
+        return Tenant::where('is_active', true)->where('subdomain', 'grndctrl')->value('id')
+            ?? \Illuminate\Support\Facades\DB::table('tenant_appointments')->join('tenants', 'tenants.id', '=', 'tenant_appointments.tenant_id')
+                ->where('tenants.is_active', true)->groupBy('tenant_appointments.tenant_id')->orderByRaw('COUNT(*) DESC')->value('tenant_appointments.tenant_id')
+            ?? Tenant::where('is_active', true)->orderBy('name')->value('id');
+    }
+
+    public function updatedShop(): void
+    {
+        $this->role = 'owner';
+    }
+
+    public function getTitle(): string
+    {
+        if ($this->b !== '') return 'Preview: ' . (TemplateStore::blockNames()[$this->b] ?? 'block');
+
+        return 'Preview: ' . (DashboardTemplate::where('key', $this->t)->value('name') ?? 'template');
+    }
+
+    protected function getViewData(): array
+    {
+        $tpl = $this->t !== '' ? DashboardTemplate::with('liveVersion')->where('key', $this->t)->first() : null;
+        $tenant = Tenant::find($this->shop);
+        $roles = $tenant ? TenantRole::where('tenant_id', $tenant->id)->get()
+            ->reject(fn ($r) => $r->isOwnerRole())->sortBy(fn ($r) => ($r->is_system ? '0' : '1') . $r->name)->pluck('name', 'id')->all() : [];
+
+        // whether this shop would get the template at all
+        $gets = null;
+        if ($tpl && $tenant) {
+            $gets = $tpl->is_default ? [true, 'the default goes to every shop'] : Audience::check($tpl->audience, $tenant);
+        }
+        $blockDef = $this->b !== '' ? (BlockRegistry::all()[$this->b] ?? null) : null;
+
+        return [
+            'tpl'      => $tpl,
+            'tenant'   => $tenant,
+            'shops'    => Tenant::where('is_active', true)->orderBy('name')->limit(300)->pluck('name', 'id')->all(),
+            'roles'    => $roles,
+            'gets'     => $gets,
+            'hasDraft' => $tpl && is_array($tpl->draft_layout),
+            'hasLive'  => $tpl && $tpl->live_version_id,
+            'blockDef' => $blockDef,
+            'blockName'=> $this->b !== '' ? (TemplateStore::blockNames()[$this->b] ?? $this->b) : null,
+            'src'      => $tenant ? route('admin.dashboard-preview.frame', array_filter([
+                't' => $this->t ?: null, 'v' => $this->t ? $this->v : null, 'b' => $this->b ?: null, 'w' => $this->b ? $this->w : null,
+                'shop' => $tenant->id, 'role' => $this->role,
+            ])) : null,
+            'back'     => $this->b !== ''
+                ? (! empty($blockDef['custom']) ? DashboardBlockBuilder::getUrl(['k' => $this->b]) : DashboardBlocks::getUrl())
+                : DashboardEditor::getUrl(['t' => $this->t]),
+        ];
+    }
+}
diff --git a/app/Http/Controllers/Admin/DashboardPreviewController.php b/app/Http/Controllers/Admin/DashboardPreviewController.php
new file mode 100644
index 00000000..d1a516f8
--- /dev/null
+++ b/app/Http/Controllers/Admin/DashboardPreviewController.php
@@ -0,0 +1,108 @@
+<?php
+
+namespace App\Http\Controllers\Admin;
+
+use App\Http\Controllers\Controller;
+use App\Models\DashboardBlock;
+use App\Models\Tenant;
+use App\Models\Tenant\TenantRole;
+use App\Models\Tenant\TenantUser;
+use App\Support\Dashboard\BlockAccess;
+use App\Support\Dashboard\BlockRegistry;
+use App\Support\Dashboard\DashboardPage;
+use App\Support\Dashboard\DashboardTemplates;
+use App\Support\Dashboard\Layout;
+use App\Support\Dashboard\TemplateStore;
+use Illuminate\Http\Request;
+use Illuminate\Support\Facades\View;
+
+/**
+ * MARKER-DASH-PREVIEW: one shop's dashboard as one of its roles would see
+ * it, drawn inside master admin's preview (DashboardPreview page, in an
+ * iframe). The same frame views and DashboardPage data as the shop's own
+ * dashboard; only the layout around it differs (no sidebar, nothing
+ * clickable). Read-only: nothing here writes to the shop.
+ *
+ *   ?t=key&v=live|draft   a template          ?b=key&w=4|6|8|12   one block
+ *   &shop=tenant id       &role=role id, or "owner"
+ */
+class DashboardPreviewController extends Controller
+{
+    public function frame(Request $request)
+    {
+        $tenant = Tenant::findOrFail((string) $request->query('shop'));
+        $user = self::person($tenant, (string) $request->query('role', 'owner'));
+
+        $hadTenant = app()->bound('tenant');
+        $prevTenant = $hadTenant ? app('tenant') : null;
+        app()->instance('tenant', $tenant);
+        try {
+            $see = BlockAccess::for($user);
+            $template = self::template($request, $tenant);
+            $rows = Layout::personal($template['rows'], $see->blocked(), [], 'none');
+
+            $theme = (array) ($tenant->settings ?? []);
+            $theme = in_array($theme['admin_theme'] ?? 'c', ['b', 'c'], true) ? ($theme['admin_theme'] ?? 'c') : 'c';
+            View::share('currentTenant', $tenant);
+            View::share('adminTheme', $theme);
+
+            // a single block has no switch; a template shows the shop's own switch, with it in
+            $switch = [];
+            if ($template['key'] !== 'preview') {
+                $switch = DashboardTemplates::switchable($tenant);
+                if (! in_array($template['key'], array_column($switch, 'key'), true)) $switch[] = $template;
+            }
+
+            $data = DashboardPage::data($tenant, $user, $see, $rows) + [
+                'activeTemplate'  => $template,
+                'switchTemplates' => $switch,
+                'customize'       => null,
+                'dashLayout'      => 'layouts.tenant.preview',
+                'pageTitle'       => 'Preview',
+            ];
+            $html = view(DashboardTemplates::frameView($template), $data)->render();
+        } finally {
+            $hadTenant ? app()->instance('tenant', $prevTenant) : app()->forgetInstance('tenant');
+        }
+
+        return response($html)->header('X-Frame-Options', 'SAMEORIGIN')->header('Cache-Control', 'no-store');
+    }
+
+    /** A stand-in person with the chosen role. Never saved. */
+    public static function person(Tenant $tenant, string $roleId): TenantUser
+    {
+        $role = $roleId !== 'owner' ? TenantRole::where('tenant_id', $tenant->id)->find($roleId) : null;
+        $u = new TenantUser();
+        $u->forceFill(['tenant_id' => $tenant->id, 'name' => '', 'is_active' => true,
+            'role' => ! $role || $role->isOwnerRole() ? 'owner' : ($role->is_system && $role->name === 'Manager' ? 'manager' : 'staff')]);
+        $u->setRelation('accessRole', $role);
+        $u->setRelation('tenant', $tenant);
+
+        return $u;
+    }
+
+    /** The template (or one block) to draw, in DashboardTemplates' shape. */
+    private static function template(Request $request, Tenant $tenant): array
+    {
+        $hidden = DashboardBlock::whereNotNull('hidden_at')->pluck('key')->all();
+        $b = (string) $request->query('b', '');
+        if ($b !== '') {
+            abort_unless(isset(BlockRegistry::all()[$b]), 404);
+            $w = (int) $request->query('w', 12);
+            $w = in_array($w, [4, 6, 8], true) ? $w : 12;
+            $rows = [['split' => $w === 12 ? [12] : [$w, 12 - $w], 'cols' => $w === 12 ? [[['b' => $b]]] : [[['b' => $b]], []]]];
+
+            return ['key' => 'preview', 'name' => 'Preview', 'frame' => 'standard', 'label' => 'Preview', 'beta' => false, 'icon' => 'custom',
+                'default' => false, 'rearrange' => 'none', 'audience' => null,
+                'rows' => Layout::visible($rows)];
+        }
+
+        $t = TemplateStore::find((string) $request->query('t'));
+        $layout = $request->query('v') === 'draft' ? TemplateStore::workingLayout($t) : (TemplateStore::liveLayout($t) ?? TemplateStore::workingLayout($t));
+
+        return ['key' => $t->key, 'name' => $t->name, 'frame' => array_key_exists($t->frame, DashboardTemplates::FRAMES) ? $t->frame : 'standard',
+            'label' => $t->switch_label ?: $t->name, 'beta' => (bool) $t->beta_badge, 'icon' => $t->icon ?: $t->frame,
+            'default' => (bool) $t->is_default, 'rearrange' => 'none', 'audience' => $t->audience,
+            'rows' => Layout::visible($layout, $hidden)];
+    }
+}
