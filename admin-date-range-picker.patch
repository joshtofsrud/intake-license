diff --git a/public/css/admin/date-range.css b/public/css/admin/date-range.css
new file mode 100644
index 00000000..52d12cef
--- /dev/null
+++ b/public/css/admin/date-range.css
@@ -0,0 +1,109 @@
+/* Date range picker — master admin.
+   The tenant picker (components/tenant/date-range) carried into master admin:
+   same layout and sizes, in the admin's own palette (Filament's primary,
+   violet). Loaded on every admin page from AdminPanelProvider. */
+
+.adr {
+    --adr-surface:   rgb(24 24 27);
+    --adr-surface-2: rgba(255,255,255,.035);
+    --adr-border:    rgba(255,255,255,.12);
+    --adr-border-2:  rgba(255,255,255,.24);
+    --adr-text:      #f4f4f5;
+    --adr-muted:     rgba(244,244,245,.55);
+    --adr-hover:     rgba(255,255,255,.06);
+    --adr-accent:    rgb(var(--primary-500, 139, 92, 246));
+    --adr-accent-soft: rgba(var(--primary-500, 139, 92, 246), .2);
+    --adr-accent-text: #fff;
+    position: relative;
+    display: inline-block;
+}
+html:not(.dark) .adr {
+    --adr-surface:   #fff;
+    --adr-surface-2: rgba(0,0,0,.025);
+    --adr-border:    rgba(0,0,0,.12);
+    --adr-border-2:  rgba(0,0,0,.25);
+    --adr-text:      #18181b;
+    --adr-muted:     rgba(24,24,27,.55);
+    --adr-hover:     rgba(0,0,0,.05);
+    --adr-accent-soft: rgba(var(--primary-500, 139, 92, 246), .14);
+}
+
+.adr-trigger {
+    display: inline-flex; align-items: center; gap: 6px;
+    border: 1px solid rgba(127,127,127,.3); background: transparent; color: inherit;
+    border-radius: 8px; padding: 5px 10px; font: inherit; font-size: 13px;
+    cursor: pointer; white-space: nowrap;
+}
+.adr-trigger:hover { border-color: rgba(127,127,127,.55); }
+.adr-trigger.is-on { border-color: var(--adr-accent); color: var(--adr-accent); }
+.adr-trigger[hidden] { display: none; }
+
+.adr-pop {
+    position: absolute; top: calc(100% + 4px); left: 0; z-index: 60;
+    background: var(--adr-surface); color: var(--adr-text);
+    border: 1px solid var(--adr-border); border-radius: 10px;
+    padding: 12px; box-shadow: 0 8px 24px rgba(0,0,0,.4);
+    width: 300px; user-select: none; font-size: 13px;
+}
+.adr-pop[hidden] { display: none; }
+.adr-pop.is-flip-right { left: auto; right: 0; }
+
+.adr-presets {
+    display: flex; flex-wrap: wrap; gap: 4px;
+    margin-bottom: 10px; padding-bottom: 10px; border-bottom: 1px solid var(--adr-border);
+}
+.adr-preset {
+    background: transparent; border: 1px solid var(--adr-border); border-radius: 5px;
+    padding: 4px 9px; font-size: 11px; color: var(--adr-muted); cursor: pointer; font-family: inherit;
+}
+.adr-preset:hover { color: var(--adr-text); border-color: var(--adr-border-2); }
+
+.adr-cal { background: var(--adr-surface-2); border: 1px solid var(--adr-border); border-radius: 8px; padding: 10px; }
+.adr-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 8px; }
+.adr-title { font-size: 13px; font-weight: 600; }
+.adr-nav {
+    background: transparent; border: 1px solid var(--adr-border); border-radius: 5px;
+    width: 26px; height: 26px; cursor: pointer; color: var(--adr-muted);
+    font-size: 14px; line-height: 1; font-family: inherit;
+    display: flex; align-items: center; justify-content: center;
+}
+.adr-nav:hover { color: var(--adr-text); border-color: var(--adr-border-2); }
+
+.adr-dows {
+    display: grid; grid-template-columns: repeat(7, 1fr); gap: 2px; margin-bottom: 4px;
+    font-size: 9.5px; text-transform: uppercase; letter-spacing: .06em;
+    color: var(--adr-muted); font-weight: 600; text-align: center;
+}
+.adr-grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 2px; }
+
+.adr-cell {
+    aspect-ratio: 1; display: flex; align-items: center; justify-content: center;
+    font-size: 12px; border-radius: 4px; cursor: pointer; background: transparent; border: none;
+    color: var(--adr-muted); font-family: inherit; position: relative;
+}
+.adr-cell:hover:not(:disabled):not(.is-empty):not(.is-range-start):not(.is-range-end):not(.is-in-range) { background: var(--adr-hover); color: var(--adr-text); }
+.adr-cell.is-empty { cursor: default; pointer-events: none; }
+.adr-cell.is-today { outline: 1px solid var(--adr-accent); outline-offset: -1px; }
+.adr-cell.is-in-range { background: var(--adr-accent-soft); color: var(--adr-text); border-radius: 0; }
+.adr-cell.is-range-start { background: var(--adr-accent); color: var(--adr-accent-text); font-weight: 600; border-top-right-radius: 0; border-bottom-right-radius: 0; }
+.adr-cell.is-range-end { background: var(--adr-accent); color: var(--adr-accent-text); font-weight: 600; border-top-left-radius: 0; border-bottom-left-radius: 0; }
+.adr-cell.is-range-start.is-range-end { border-radius: 4px; }
+.adr-cell.is-in-range.is-row-end { border-top-right-radius: 4px; border-bottom-right-radius: 4px; }
+.adr-cell.is-in-range.is-row-start { border-top-left-radius: 4px; border-bottom-left-radius: 4px; }
+
+.adr-summary {
+    margin-top: 10px; padding: 6px 10px; background: var(--adr-surface-2); border-radius: 6px;
+    font-size: 12px; color: var(--adr-muted); text-align: center; min-height: 28px;
+    display: flex; align-items: center; justify-content: center;
+}
+
+.adr-actions { display: flex; gap: 6px; margin-top: 10px; justify-content: flex-end; }
+.adr-btn {
+    padding: 5px 12px; font-size: 12px; border-radius: 6px; cursor: pointer; font-family: inherit;
+    border: 1px solid var(--adr-border); background: transparent; color: var(--adr-text);
+}
+.adr-btn:hover { border-color: var(--adr-border-2); }
+.adr-btn--primary { background: var(--adr-accent); border-color: var(--adr-accent); color: var(--adr-accent-text); font-weight: 600; }
+.adr-btn--primary:hover { filter: brightness(1.08); }
+.adr-btn--ghost { border-color: transparent; }
+.adr-clear { margin-right: auto; color: #EF4444; }
